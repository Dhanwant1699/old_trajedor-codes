# Trajedor Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS LOCALLY.
# NEVER SHARE YOUR .env FILE OR POST IT ONLINE!

# --- X (Twitter) Automation Credentials ---
# Option 1: Standard Login (Handled locally on your PC)
X_USERNAME="your_x_username"
X_EMAIL="your_x_email@example.com"
X_PASSWORD="your_x_password_here"

# Option 2: Browser Cookie Authentication (Safer, bypasses 2FA)
# (Get from Chrome/Edge Developer Tools -> Application -> Cookies -> x.com)
X_AUTH_TOKEN=""
X_CT0=""

# Target Gold / Forex Traders to Monitor on X
# Comma-separated list of Twitter handles (without @)
MONITORED_TRADERS="GoldTelegraph_,Fxhedgers,unusual_whales,zerohedge"

# --- Free Financial News & Macro APIs ---
# Get free key from: https://finnhub.io
FINNHUB_API_KEY=""

# Get free key from: https://fred.stlouisfed.org
FRED_API_KEY=""
