<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>⚡ BULLION AI TRADER - Institutional Multi-Asset 3D Command Center</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet">
    <script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
    <script src="/three.r128.min.js"></script>
    <style>

        :root {
            --bg: #07090e;
            --card-bg: #0e121d;
            --card-border: rgba(0, 240, 255, 0.15);
            --card-hover: rgba(0, 240, 255, 0.3);
            --accent-gold: #f59e0b;
            --accent-gold-glow: rgba(245, 158, 11, 0.25);
            --accent-btc: #f7931a;
            --accent-btc-glow: rgba(247, 147, 26, 0.25);
            --buy-green: #10b981;
            --buy-glow: rgba(16, 185, 129, 0.25);
            --sell-red: #ef4444;
            --sell-glow: rgba(239, 68, 68, 0.25);
            --hold-blue: #38bdf8;
            --hold-glow: rgba(56, 189, 248, 0.25);
            --purple-accent: #a855f7;
            --pink-accent: #ec4899;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --text-sub: #64748b;
            --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg);
            background-image: 
                radial-gradient(at 10% 10%, rgba(0, 240, 255, 0.04) 0px, transparent 50%),
                radial-gradient(at 90% 10%, rgba(168, 85, 247, 0.04) 0px, transparent 50%),
                radial-gradient(at 50% 90%, rgba(245, 158, 11, 0.03) 0px, transparent 50%);
            color: var(--text-main);
            font-family: var(--font-main);
            min-height: 100vh;
            padding: 16px 20px;
            overflow-x: hidden;
            letter-spacing: -0.01em;
        }

        /* Top Header */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
            background: linear-gradient(135deg, rgba(14, 18, 29, 0.95), rgba(10, 14, 24, 0.95));
            border: 1px solid var(--card-border);
            border-radius: 14px;
            backdrop-filter: blur(20px);
            margin-bottom: 14px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        }

        .brand-section {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #00f0ff, #0284c7);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 0 18px rgba(0, 240, 255, 0.35);
        }

        .brand-title h1 {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff;
        }

        .badge-live {
            background: rgba(16, 185, 129, 0.12);
            color: var(--buy-green);
            border: 1px solid rgba(16, 185, 129, 0.3);
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 20px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .pulse-dot {
            width: 6px;
            height: 6px;
            background: var(--buy-green);
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.4); opacity: 1; filter: drop-shadow(0 0 4px var(--buy-green)); }
            100% { transform: scale(0.95); opacity: 0.8; }
        }

        .brand-sub {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 2px;
            font-weight: 500;
        }

        /* Asset Tabs Navigation */
        .asset-tabs-nav {
            display: flex;
            gap: 6px;
            margin-bottom: 16px;
            background: rgba(14, 18, 29, 0.8);
            padding: 5px;
            border-radius: 12px;
            border: 1px solid var(--card-border);
            width: fit-content;
            flex-wrap: wrap;
        }

        .asset-tab-btn {
            background: transparent;
            border: 1px solid transparent;
            color: var(--text-muted);
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: var(--font-main);
        }

        .asset-tab-btn:hover {
            color: var(--text-main);
            background: rgba(255, 255, 255, 0.04);
        }

        .asset-tab-btn.active-neural {
            background: linear-gradient(135deg, rgba(0, 240, 255, 0.25), rgba(2, 132, 199, 0.2));
            color: #00f0ff;
            border: 1px solid #00f0ff;
            box-shadow: 0 0 16px rgba(0, 240, 255, 0.4);
        }

        .asset-tab-btn.active-gold {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(217, 119, 6, 0.15));
            color: #fbbf24;
            border: 1px solid var(--accent-gold);
            box-shadow: 0 0 16px var(--accent-gold-glow);
        }

        .asset-tab-btn.active-btc {
            background: linear-gradient(135deg, rgba(247, 147, 26, 0.2), rgba(217, 119, 6, 0.15));
            color: #f7931a;
            border: 1px solid var(--accent-btc);
            box-shadow: 0 0 16px var(--accent-btc-glow);
        }

        .asset-tab-btn.active-insights {
            background: linear-gradient(135deg, rgba(168, 85, 247, 0.25), rgba(124, 58, 237, 0.15));
            color: #c084fc;
            border: 1px solid #a855f7;
            box-shadow: 0 0 16px rgba(168, 85, 247, 0.35);
        }

        /* App Layout */
        .app-layout {
            display: flex;
            gap: 18px;
            min-height: calc(100vh - 36px);
            position: relative;
            align-items: flex-start;
        }

        .sidebar-panel {
            width: 240px;
            min-width: 240px;
            background: linear-gradient(145deg, rgba(12, 16, 26, 0.95), rgba(8, 12, 20, 0.95));
            border: 1px solid var(--card-border);
            border-radius: 16px;
            backdrop-filter: blur(24px);
            padding: 16px 14px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            position: sticky;
            top: 16px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.45);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 50;
        }

        .sidebar-panel.collapsed {
            width: 72px;
            min-width: 72px;
            padding: 16px 10px;
        }

        .sidebar-panel.collapsed .sidebar-hide-on-collapse {
            display: none !important;
        }

        .sidebar-panel.collapsed .sidebar-nav-item {
            justify-content: center;
            padding: 10px;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .sidebar-brand-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-logo {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #00f0ff, #0284c7);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            box-shadow: 0 0 16px rgba(0, 240, 255, 0.35);
            flex-shrink: 0;
        }

        .sidebar-title {
            font-size: 13px;
            font-weight: 800;
            letter-spacing: -0.3px;
            color: #fff;
            line-height: 1.2;
        }

        .sidebar-subtitle {
            font-size: 10px;
            color: #00f0ff;
            font-family: var(--font-mono);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .sidebar-toggle-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: var(--text-muted);
            width: 28px;
            height: 28px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 12px;
        }

        .sidebar-section-title {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-sub);
            margin-bottom: 4px;
            padding-left: 4px;
        }

        .sidebar-nav-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
            list-style: none;
        }

        .sidebar-nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            border-radius: 10px;
            color: var(--text-muted);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid transparent;
            text-decoration: none;
            position: relative;
        }

        .sidebar-nav-item:hover {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-main);
            transform: translateX(2px);
        }

        .sidebar-nav-item.active {
            background: linear-gradient(135deg, rgba(0, 240, 255, 0.2), rgba(2, 132, 199, 0.15));
            color: #00f0ff;
            border: 1px solid rgba(0, 240, 255, 0.35);
            box-shadow: 0 0 16px rgba(0, 240, 255, 0.2);
        }

        .sidebar-nav-icon {
            font-size: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            flex-shrink: 0;
        }

        .sidebar-nav-badge {
            margin-left: auto;
            font-size: 9px;
            font-family: var(--font-mono);
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 6px;
        }

        .main-content {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        /* ================= 🌐 3D NEURAL COMMAND CENTER STYLES ================= */
        .bullion-neural-layout {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin: 0 auto 24px auto;
            font-family: var(--font-main);
            color: #f8fafc;
            width: 100%;
            max-width: 1360px;
            box-sizing: border-box;
            position: relative;
        }

        #neuralThreadsCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 4;
        }

        .neural-glass-panel {
            background: linear-gradient(145deg, rgba(6, 11, 24, 0.94), rgba(8, 15, 32, 0.92));
            border: 1px solid rgba(0, 240, 255, 0.22);
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), inset 0 0 20px rgba(0, 240, 255, 0.03);
            position: relative;
            overflow: hidden;
            z-index: 2;
        }

        .neural-top-radar {
            padding: 12px 16px;
            width: 100%;
            box-sizing: border-box;
        }

        .neural-radar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .neural-radar-title-box {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .neural-brand-logo {
            font-size: 15px;
            font-weight: 900;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 6px;
            letter-spacing: -0.5px;
        }

        .neural-brand-logo span.cyan-glow {
            color: #00f0ff;
            text-shadow: 0 0 16px rgba(0, 240, 255, 0.9);
        }

        .neural-radar-title {
            font-size: 12px;
            font-weight: 700;
            color: #e2e8f0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .neural-radar-subtitle {
            font-size: 10px;
            color: #64748b;
            font-family: var(--font-mono);
        }

        .neural-badges-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .neural-asset-pill {
            background: rgba(0, 240, 255, 0.1);
            border: 1px solid rgba(0, 240, 255, 0.35);
            color: #00f0ff;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .neural-asset-pill:hover {
            background: rgba(0, 240, 255, 0.25);
            box-shadow: 0 0 14px rgba(0, 240, 255, 0.4);
            transform: scale(1.03);
        }

        .neural-harmony-pill {
            background: rgba(245, 158, 11, 0.12);
            border: 1px solid rgba(245, 158, 11, 0.4);
            color: #fbbf24;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .neural-confluence-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 10.5px;
            color: #94a3b8;
            margin-bottom: 8px;
            padding-bottom: 6px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .neural-confluence-highlight {
            color: #00f0ff;
            font-weight: 700;
            font-family: var(--font-mono);
        }

        .neural-tf-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 8px;
        }

        @media (max-width: 1100px) {
            .neural-tf-grid { grid-template-columns: repeat(3, 1fr); }
        }
        @media (max-width: 768px) {
            .neural-tf-grid { grid-template-columns: repeat(2, 1fr); }
        }

        .neural-tf-card {
            background: rgba(4, 8, 18, 0.85);
            border: 1px solid rgba(0, 240, 255, 0.2);
            border-radius: 8px;
            padding: 8px 9px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            z-index: 5;
        }

        .neural-tf-card:hover {
            border-color: rgba(0, 240, 255, 0.6);
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(0, 240, 255, 0.2);
        }

        .neural-tf-card.bearish-border {
            border-color: rgba(239, 68, 68, 0.45);
            border-left: 3px solid #ef4444;
        }

        .neural-tf-card.bullish-border {
            border-color: rgba(16, 185, 129, 0.45);
            border-left: 3px solid #10b981;
        }

        .neural-tf-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3px;
        }

        .neural-tf-title {
            font-size: 10px;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .neural-tf-pattern {
            font-size: 10.5px;
            font-weight: 800;
            color: #fbbf24;
            margin-bottom: 2px;
            line-height: 1.2;
        }

        .neural-tf-struct {
            font-size: 9px;
            color: #94a3b8;
            line-height: 1.2;
            margin-bottom: 4px;
            min-height: 20px;
        }

        .neural-tf-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 3px;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            font-size: 9px;
            color: #64748b;
            font-family: var(--font-mono);
        }

        .neural-tf-target { color: #e2e8f0; }

        .neural-ask-btn {
            background: rgba(0, 240, 255, 0.1);
            border: 1px solid rgba(0, 240, 255, 0.35);
            color: #00f0ff;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 8.5px;
            font-weight: 700;
            font-family: var(--font-mono);
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 2px;
        }

        .neural-ask-btn:hover {
            background: rgba(0, 240, 255, 0.3);
            color: #fff;
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
        }

        /* Center 3-Zone Grid: Left 240px | Center (Brain) 1fr | Right 240px */
        .neural-center-grid {
            display: grid;
            grid-template-columns: 240px 1fr 240px;
            gap: 14px;
            align-items: center;
            position: relative;
            min-height: 520px;
            z-index: 2;
            width: 100%;
            box-sizing: border-box;
        }

        @media (max-width: 1050px) {
            .neural-center-grid { grid-template-columns: 1fr; }
        }

        .neural-agents-panel {
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 5;
            position: relative;
        }

        .neural-col-header {
            margin-bottom: 2px;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .neural-col-title {
            font-size: 10.5px;
            font-weight: 800;
            color: #00f0ff;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 5px;
            text-transform: uppercase;
        }

        .neural-col-sub {
            font-size: 8.5px;
            color: #94a3b8;
        }

        .neural-agents-clean-list {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .neural-model-card {
            background: linear-gradient(135deg, rgba(6, 12, 26, 0.94), rgba(10, 20, 42, 0.9));
            border: 1px solid rgba(0, 240, 255, 0.25);
            border-radius: 8px;
            padding: 9px 11px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
            cursor: pointer;
            z-index: 5;
        }

        .neural-model-card:hover {
            border-color: rgba(0, 240, 255, 0.7);
            transform: translateX(3px);
            box-shadow: 0 0 18px rgba(0, 240, 255, 0.35);
            background: linear-gradient(135deg, rgba(8, 18, 38, 0.98), rgba(14, 28, 56, 0.95));
        }

        .neural-model-left {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .neural-model-icon { font-size: 14px; }

        .neural-model-name {
            font-size: 11px;
            font-weight: 800;
            color: #fff;
            letter-spacing: 0.2px;
            white-space: nowrap;
        }

        .neural-model-right {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .neural-model-conf {
            font-size: 10px;
            font-weight: 700;
            font-family: var(--font-mono);
            color: #00f0ff;
            background: rgba(0, 240, 255, 0.08);
            padding: 2px 5px;
            border-radius: 4px;
            border: 1px solid rgba(0, 240, 255, 0.25);
        }

        .neural-core-center-wrapper {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            padding: 0;
            z-index: 2;
            background: transparent;
            border: none;
            box-shadow: none;
            width: 100%;
        }

        .neural-globe-viewport {
            position: relative;
            width: 100%;
            height: 480px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: visible;
        }

        #bullionNeuralGlobeCanvas {
            width: 100%;
            height: 100%;
            display: block;
            cursor: grab;
            position: relative;
            z-index: 3;
        }

        #bullionNeuralGlobeCanvas:active { cursor: grabbing; }

        .neural-center-master-badge {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            pointer-events: none;
            z-index: 10;
        }

        .neural-badge-pill {
            background: rgba(4, 10, 26, 0.92);
            border: 1.5px solid #00f0ff;
            border-radius: 12px;
            padding: 8px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 0 30px rgba(0, 240, 255, 0.7), inset 0 0 16px rgba(0, 240, 255, 0.25);
            backdrop-filter: blur(12px);
            animation: badgeNeonGlow 3s infinite alternate ease-in-out;
        }

        @keyframes badgeNeonGlow {
            0% { box-shadow: 0 0 20px rgba(0, 240, 255, 0.5), inset 0 0 10px rgba(0, 240, 255, 0.2); }
            100% { box-shadow: 0 0 45px rgba(0, 240, 255, 0.9), inset 0 0 22px rgba(0, 240, 255, 0.4); }
        }

        .neural-badge-waveform {
            width: 24px;
            height: 18px;
            color: #00f0ff;
            filter: drop-shadow(0 0 8px #00f0ff);
        }

        .neural-badge-text-box {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .neural-badge-main-text {
            font-size: 14px;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: 2px;
            font-family: var(--font-mono);
            line-height: 1.1;
            text-shadow: 0 0 12px rgba(255, 255, 255, 0.8);
        }

        .neural-badge-sub-text {
            font-size: 11px;
            font-weight: 800;
            color: #00f0ff;
            letter-spacing: 3px;
            font-family: var(--font-mono);
            line-height: 1.1;
            margin-top: 1px;
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.9);
        }

        .neural-trades-live-pill {
            background: rgba(3, 8, 20, 0.9);
            border: 1px solid rgba(16, 185, 129, 0.5);
            border-radius: 20px;
            padding: 3px 10px;
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 6px;
            box-shadow: 0 0 16px rgba(16, 185, 129, 0.35);
        }

        .neural-trades-num {
            font-size: 10px;
            font-weight: 900;
            font-family: var(--font-mono);
            color: #10b981;
            text-shadow: 0 0 8px rgba(16, 185, 129, 0.8);
        }

        .neural-trades-tag {
            font-size: 8px;
            font-weight: 800;
            color: #e2e8f0;
            letter-spacing: 0.5px;
            font-family: var(--font-mono);
        }

        .neural-status-strip {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            width: 100%;
            margin-top: 6px;
            box-sizing: border-box;
            z-index: 5;
        }

        .neural-status-pill {
            background: rgba(5, 10, 24, 0.9);
            border: 1px solid rgba(0, 240, 255, 0.28);
            border-radius: 8px;
            padding: 5px 8px;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: all 0.2s;
            position: relative;
            z-index: 5;
        }

        .neural-status-pill:hover {
            border-color: rgba(0, 240, 255, 0.6);
            box-shadow: 0 0 12px rgba(0, 240, 255, 0.25);
        }

        .neural-status-icon { font-size: 11px; }

        .neural-status-info {
            display: flex;
            flex-direction: column;
        }

        .neural-status-label {
            font-size: 7.5px;
            color: #64748b;
            text-transform: uppercase;
            font-family: var(--font-mono);
        }

        .neural-status-val {
            font-size: 9.5px;
            font-weight: 700;
            color: #00f0ff;
            display: flex;
            align-items: center;
            gap: 3px;
        }

        .neural-sentry-section {
            padding: 12px 16px;
            z-index: 2;
            width: 100%;
            box-sizing: border-box;
        }

        .neural-sentry-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .neural-sentry-title-box {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .neural-sentry-title {
            font-size: 12px;
            font-weight: 800;
            color: #fff;
        }

        .neural-sentry-sub {
            font-size: 10px;
            color: #64748b;
            font-family: var(--font-mono);
        }

        .neural-sentry-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 6px;
            margin-bottom: 8px;
            z-index: 5;
        }

        @media (max-width: 1200px) {
            .neural-sentry-grid { grid-template-columns: repeat(4, 1fr); }
        }
        @media (max-width: 768px) {
            .neural-sentry-grid { grid-template-columns: repeat(2, 1fr); }
        }

        .neural-sentry-card {
            background: rgba(4, 8, 18, 0.85);
            border: 1px solid rgba(0, 240, 255, 0.2);
            border-radius: 8px;
            padding: 7px 8px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 3px;
            transition: all 0.2s;
            position: relative;
            z-index: 5;
        }

        .neural-sentry-card:hover {
            border-color: rgba(0, 240, 255, 0.5);
            transform: translateY(-2px);
            box-shadow: 0 4px 14px rgba(0, 240, 255, 0.15);
        }

        .neural-sentry-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .neural-sentry-name {
            font-size: 9.5px;
            font-weight: 700;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .neural-sentry-metric {
            font-size: 8.5px;
            color: #fbbf24;
            font-weight: 600;
            font-family: var(--font-mono);
        }

        .neural-sentry-desc {
            font-size: 8px;
            color: #94a3b8;
            line-height: 1.2;
            min-height: 18px;
        }

        .neural-sentry-status-bar {
            background: rgba(0, 240, 255, 0.05);
            border: 1px solid rgba(0, 240, 255, 0.22);
            border-radius: 8px;
            padding: 6px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 10px;
            font-family: var(--font-mono);
            color: #94a3b8;
            flex-wrap: wrap;
            gap: 6px;
            z-index: 2;
        }

        .neural-sentry-status-left {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #e2e8f0;
        }

        .neural-sentry-status-right {
            color: #00f0ff;
            font-weight: 700;
        }

        /* Generic styles for other tabs */
        .chart-container-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 18px; padding: 20px; margin-bottom: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); }
        .chart-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; padding-bottom: 14px; border-bottom: 1px solid rgba(255,255,255,0.08); }
        .chart-tab-group { display: flex; align-items: center; gap: 8px; background: rgba(0,0,0,0.4); padding: 4px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.06); }
        .chart-tab-btn { background: transparent; border: none; color: var(--text-muted); font-family: var(--font-main); font-size: 13px; font-weight: 700; padding: 8px 14px; border-radius: 8px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 6px; }
        .chart-tab-btn:hover { color: #fff; background: rgba(255,255,255,0.06); }
        .chart-tab-btn.active-gold { background: linear-gradient(135deg, rgba(245,158,11,0.25), rgba(217,119,6,0.15)); color: #fbbf24; border: 1px solid var(--accent-gold); box-shadow: 0 0 15px var(--accent-gold-glow); }
        .chart-tab-btn.active-btc { background: linear-gradient(135deg, rgba(247,147,26,0.25), rgba(194,105,7,0.15)); color: #f7931a; border: 1px solid var(--accent-btc); box-shadow: 0 0 15px var(--accent-btc-glow); }
        .chart-tab-btn.active-dual { background: linear-gradient(135deg, rgba(59,130,246,0.25), rgba(37,99,235,0.15)); color: #60a5fa; border: 1px solid #3b82f6; box-shadow: 0 0 15px rgba(59,130,246,0.3); }
        .btn { background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.15); padding: 8px 16px; border-radius: 8px; cursor: pointer; font-family: var(--font-main); font-weight: 600; transition: all 0.2s; }
        .btn:hover { background: rgba(255,255,255,0.15); }
        .agent-badge { font-size: 9px; padding: 2px 5px; border-radius: 4px; font-weight: 700; font-family: var(--font-mono); }
        .badge-buy { background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4); }
        .badge-sell { background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4); }
        .badge-hold { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.4); }
        .badge-status-active { background: rgba(16, 185, 129, 0.15); color: #10b981; font-size: 10px; padding: 2px 8px; border-radius: 12px; font-weight: 700; }
        .hero-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
        .hero-kpi-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 18px; padding: 20px 22px; display: flex; flex-direction: column; justify-content: space-between; min-height: 128px; }
        .hero-kpi-top { display: flex; justify-content: space-between; align-items: center; }
        .hero-kpi-label { font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; }
        .hero-kpi-icon-box { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
        .hero-kpi-value { font-size: 28px; font-weight: 800; font-family: var(--font-mono); color: #fff; margin: 10px 0 6px 0; }
        .hero-kpi-badge { font-size: 11px; font-family: var(--font-mono); color: var(--buy-green); display: flex; align-items: center; gap: 4px; font-weight: 600; }
        .consensus-banner { background: linear-gradient(135deg, rgba(14, 18, 28, 0.95), rgba(20, 26, 40, 0.95)); border: 1px solid var(--accent-gold-glow); border-radius: 16px; padding: 24px; margin-bottom: 24px; display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 24px; align-items: center; }
        .ai-insights-split-layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: 16px; margin-bottom: 24px; }
        .insights-panel-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 18px; padding: 20px; }
        .insights-panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.06); }
        .insights-panel-title { font-size: 14px; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 8px; }
        .model-status-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-radius: 10px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.04); margin-bottom: 6px; }
        .model-name-group { display: flex; align-items: center; gap: 10px; }
        .model-icon-avatar { font-size: 16px; }
        .agent-discuss-btn { background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.35); color: #c084fc; padding: 3px 8px; border-radius: 6px; font-size: 11px; cursor: pointer; }
        .alert-feed-item { display: flex; gap: 12px; padding: 10px 14px; border-radius: 10px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.04); margin-bottom: 6px; }
        .alert-tag-investigating { color: #fbbf24; font-family: var(--font-mono); font-size: 10px; font-weight: 700; text-transform: uppercase; }
        .alert-tag-resolved { color: #34d399; font-family: var(--font-mono); font-size: 10px; font-weight: 700; text-transform: uppercase; }
        .alert-tag-completed { color: #38bdf8; font-family: var(--font-mono); font-size: 10px; font-weight: 700; text-transform: uppercase; }
        .automation-impact-card { background: linear-gradient(135deg, rgba(14, 22, 38, 0.95), rgba(20, 32, 54, 0.95)); border: 1px solid rgba(0, 240, 255, 0.25); border-radius: 18px; padding: 22px; margin-bottom: 24px; }
        .automation-impact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px; }
        .impact-metric-box { background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 12px; padding: 16px; text-align: center; }
        .terminal-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 18px; padding: 20px; }
    
    </style>
</head>
<body>
    <div class="app-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar-panel" id="mainSidebar">
            <div class="sidebar-header">
                <div class="sidebar-brand-group">
                    <div class="sidebar-logo">⚡</div>
                    <div class="sidebar-hide-on-collapse">
                        <div class="sidebar-title">BULLION AI</div>
                        <div class="sidebar-subtitle">TRADER V4.2</div>
                    </div>
                </div>
                <div class="sidebar-toggle-btn" onclick="toggleSidebar()" title="Toggle Sidebar">
                    <span>☰</span>
                </div>
            </div>

            <div class="sidebar-section-title sidebar-hide-on-collapse">Navigation</div>
            <ul class="sidebar-nav-list">
                <li>
                    <div class="sidebar-nav-item active" id="side-nav-neural" onclick="switchAsset('NEURAL')">
                        <span class="sidebar-nav-icon">🌐</span>
                        <span class="sidebar-hide-on-collapse">3D AI Neural Core</span>
                        <span class="sidebar-nav-badge sidebar-hide-on-collapse" style="background: rgba(0,240,255,0.2); color: #00f0ff;">3D BRAIN</span>
                    </div>
                </li>
                <li>
                    <div class="sidebar-nav-item" id="side-nav-gold" onclick="switchAsset('XAUUSD')">
                        <span class="sidebar-nav-icon">🥇</span>
                        <span class="sidebar-hide-on-collapse">Gold Cockpit</span>
                        <span class="sidebar-nav-badge sidebar-hide-on-collapse" style="background: rgba(245,158,11,0.2); color: #fbbf24;">XAUUSD</span>
                    </div>
                </li>
                <li>
                    <div class="sidebar-nav-item" id="side-nav-btc" onclick="switchAsset('BTCUSD')">
                        <span class="sidebar-nav-icon">₿</span>
                        <span class="sidebar-hide-on-collapse">Bitcoin Cockpit</span>
                        <span class="sidebar-nav-badge sidebar-hide-on-collapse" style="background: rgba(247,147,26,0.2); color: #f7931a;">BTCUSD</span>
                    </div>
                </li>
                <li>
                    <div class="sidebar-nav-item" id="side-nav-insights" onclick="switchAsset('INSIGHTS')">
                        <span class="sidebar-nav-icon">🤖</span>
                        <span class="sidebar-hide-on-collapse">AI Models & Insights</span>
                        <span class="sidebar-nav-badge sidebar-hide-on-collapse" style="background: rgba(168,85,247,0.2); color: #c084fc;">14 MODELS</span>
                    </div>
                </li>
                <li>
                    <div class="sidebar-nav-item" id="side-nav-accounts" onclick="switchAsset('ACCOUNTS')">
                        <span class="sidebar-nav-icon">💼</span>
                        <span class="sidebar-hide-on-collapse">MT5 Accounts</span>
                        <span class="sidebar-nav-badge sidebar-hide-on-collapse" style="background: rgba(56,189,248,0.2); color: #38bdf8;">3 CONNECTED</span>
                    </div>
                </li>
                <li>
                    <div class="sidebar-nav-item" id="side-nav-history" onclick="switchAsset('HISTORY')">
                        <span class="sidebar-nav-icon">📜</span>
                        <span class="sidebar-hide-on-collapse">Trade History</span>
                        <span class="sidebar-nav-badge sidebar-hide-on-collapse" style="background: rgba(52,211,153,0.2); color: #34d399;">LIVE</span>
                    </div>
                </li>
                <li>
                    <div class="sidebar-nav-item" id="side-nav-admin" onclick="switchAsset('ADMIN')">
                        <span class="sidebar-nav-icon">⚙️</span>
                        <span class="sidebar-hide-on-collapse">Admin & Risk</span>
                        <span class="sidebar-nav-badge sidebar-hide-on-collapse" style="background: rgba(239,68,68,0.2); color: #ef4444;">CRO ARMED</span>
                    </div>
                </li>
            </ul>
        </aside>

        <!-- Main Dashboard Content -->
        <main class="main-content">
            <!-- Top Header -->
            <header>
                <div class="brand-section">
                    <div class="logo-icon">⚡</div>
                    <div class="brand-title">
                        <h1>
                            <span>BULLION AI TRADER</span>
                            <span class="badge-live"><span class="pulse-dot"></span> LIVE COUNCIL</span>
                        </h1>
                        <div class="brand-sub">Multi-Asset Autonomous Quantitative Execution Platform • Gold (XAUUSD) & Bitcoin (BTCUSD)</div>
                    </div>
                </div>
            </header>

            <!-- Asset Tabs Navigation -->
            <nav class="asset-tabs-nav">
                <button class="asset-tab-btn active-neural" id="tab-neural" onclick="switchAsset('NEURAL')">
                    <span>🌐</span>
                    <span>3D AI NEURAL CORE</span>
                    <span style="background: rgba(0, 240, 255, 0.15); color: #00f0ff; font-size: 10px; padding: 2px 7px; border-radius: 10px; border: 1px solid rgba(0, 240, 255, 0.3); font-family: var(--font-mono); font-weight: 700;">COMMAND CENTER</span>
                </button>
                <button class="asset-tab-btn" id="tab-gold" onclick="switchAsset('XAUUSD')">
                    <span>🥇</span>
                    <span>GOLD (XAUUSD)</span>
                </button>
                <button class="asset-tab-btn" id="tab-btc" onclick="switchAsset('BTCUSD')">
                    <span>₿</span>
                    <span>BITCOIN (BTCUSD)</span>
                </button>
                <button class="asset-tab-btn" id="tab-insights" onclick="switchAsset('INSIGHTS')">
                    <span>🤖</span>
                    <span>AI MODELS & INSIGHTS</span>
                </button>
                <button class="asset-tab-btn" id="tab-accounts" onclick="switchAsset('ACCOUNTS')">
                    <span>💼</span>
                    <span>MT5 ACCOUNTS</span>
                </button>
                <button class="asset-tab-btn" id="tab-history" onclick="switchAsset('HISTORY')">
                    <span>📜</span>
                    <span>TRADE HISTORY</span>
                </button>
                <button class="asset-tab-btn" id="tab-admin" onclick="switchAsset('ADMIN')">
                    <span>⚙️</span>
                    <span>ADMIN & RISK</span>
                </button>
            </nav>

            <!-- 1. 3D AI NEURAL CORE VIEW (ACTIVE BY DEFAULT) -->
<!-- ================= 🌐 3D AI NEURAL CORE COMMAND CENTER VIEW ================= -->
    <div id="neural-3d-view" style="display: block; margin-bottom: 24px;">
        <div class="bullion-neural-layout" id="bullionNeuralLayout">
            
            <!-- Full-Screen Layered Canvas for 4-Way Glowing Neural Threads (Top, Bottom, Left, Right) -->
            <canvas id="neuralThreadsCanvas"></canvas>

            <!-- TOP ZONE: Multi-Timeframe Pattern & Market Structure Radar -->
            <div class="neural-glass-panel neural-top-radar" id="neuralTopRadarPanel">
                <div class="neural-radar-header">
                    <div class="neural-radar-title-box">
                        <div class="neural-brand-logo">
                            <span>⚡</span>
                            <span>BULLION AI <span class="cyan-glow">TRADER</span></span>
                        </div>
                        <div style="border-left: 1px solid rgba(255,255,255,0.12); padding-left: 12px;">
                            <div class="neural-radar-title" id="neural-radar-main-title">
                                <span>✜</span>
                                <span>Multi-Timeframe Pattern & Market Structure Radar — <span id="neural-radar-asset-name" style="color: #00f0ff;">Bitcoin (BTCUSD)</span></span>
                                <span class="neural-radar-subtitle" style="margin-left: 8px;">(M5, M15, M30, H1, H4, D1 Confluence Matrix)</span>
                            </div>
                        </div>
                    </div>
                    <div class="neural-badges-group">
                        <div class="neural-asset-pill" id="neural-switch-asset-btn" onclick="toggleNeuralAsset()" title="Switch between BTCUSD and XAUUSD">
                            <span class="pulse-dot"></span>
                            <span id="neural-active-asset-label">BTCUSD Live</span>
                            <span style="font-size: 9px; opacity: 0.7;">⇄</span>
                        </div>
                        <div class="neural-harmony-pill" id="neural-harmony-badge">
                            <span>⭐</span>
                            <span id="neural-harmony-text">5/6 Bullish Multi-TF Harmony</span>
                        </div>
                        <div class="badge-live" id="neural-harmony-score-pill" style="border-color: #00f0ff; color: #00f0ff; background: rgba(0, 240, 255, 0.1);">
                            Harmony Score: 83%
                        </div>
                    </div>
                </div>

                <div class="neural-confluence-bar">
                    <div>
                        <span id="neural-confluence-text">Hierarchical Confluence: <span class="neural-confluence-highlight">5 Bullish</span> / <span style="color: #ef4444; font-weight: 700;">1 Bearish</span> of 6 Timeframes</span>
                    </div>
                    <div style="font-family: var(--font-mono); font-size: 10px; color: #64748b;">
                        Live Microstructure Analysis • Sub-Tick Sync Active
                    </div>
                </div>

                <!-- 6 Compact Timeframe Cards -->
                <div class="neural-tf-grid" id="neural-tf-cards-grid">
                    <!-- Daily (D1) -->
                    <div class="neural-tf-card bullish-border" id="neural-tf-d1">
                        <div>
                            <div class="neural-tf-top">
                                <span class="neural-tf-title">📅 Daily (D1)</span>
                                <span class="agent-badge badge-buy" style="font-size: 8.5px; padding: 1px 5px;">BULLISH</span>
                            </div>
                            <div class="neural-tf-pattern" id="neural-d1-pattern">Double Bottom (W-Pattern)</div>
                            <div class="neural-tf-struct" id="neural-d1-struct">$11,820 Rejection Pattern (Hammer)</div>
                        </div>
                        <div class="neural-tf-bottom">
                            <span class="neural-tf-target" id="neural-d1-target">Target: 89,601.13</span>
                            <button class="neural-ask-btn" onclick="discussTimeframe('D1', 'Daily D1')">● Ask</button>
                        </div>
                    </div>

                    <!-- 4-Hour (H4) -->
                    <div class="neural-tf-card bullish-border" id="neural-tf-h4">
                        <div>
                            <div class="neural-tf-top">
                                <span class="neural-tf-title">⏰ 4-Hour (H4)</span>
                                <span class="agent-badge badge-buy" style="font-size: 8.5px; padding: 1px 5px;">BULLISH</span>
                            </div>
                            <div class="neural-tf-pattern" id="neural-h4-pattern">Bull Flag (Continuation Channel)</div>
                            <div class="neural-tf-struct" id="neural-h4-struct">Channel Consolidation / Breakout Ready</div>
                        </div>
                        <div class="neural-tf-bottom">
                            <span class="neural-tf-target" id="neural-h4-target">Target: 85,864.43</span>
                            <button class="neural-ask-btn" onclick="discussTimeframe('H4', '4-Hour H4')">● Ask</button>
                        </div>
                    </div>

                    <!-- 1-Hour (H1) -->
                    <div class="neural-tf-card bullish-border" id="neural-tf-h1">
                        <div>
                            <div class="neural-tf-top">
                                <span class="neural-tf-title">⌛ 1-Hour (H1)</span>
                                <span class="agent-badge badge-buy" style="font-size: 8.5px; padding: 1px 5px;">BULLISH</span>
                            </div>
                            <div class="neural-tf-pattern" id="neural-h1-pattern">Standard Trend Wave</div>
                            <div class="neural-tf-struct" id="neural-h1-struct">Higher Highs & Higher Lows (HH/HL)</div>
                        </div>
                        <div class="neural-tf-bottom">
                            <span class="neural-tf-target" id="neural-h1-target">Target: 86,864.43</span>
                            <button class="neural-ask-btn" onclick="discussTimeframe('H1', '1-Hour H1')">● Ask</button>
                        </div>
                    </div>

                    <!-- 30-Min (M30) -->
