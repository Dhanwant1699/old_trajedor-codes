                    <button class="jarvis-btn" style="font-size: 10px; padding: 4px 10px; border-color: rgba(56,189,248,0.4);" onclick="sendQuickPrompt('Mera floating profit kitna chal raha hai?')">💰 "Mera profit kitna hai?"</button>
                    <button class="jarvis-btn" style="font-size: 10px; padding: 4px 10px; border-color: rgba(239,68,68,0.4);" onclick="sendQuickPrompt('Bhai thoda loss chal raha hai, mujhe tension ho rahi hai')">🧘 "Thoda loss hai, tension ho rahi hai"</button>
                    <button class="jarvis-btn" style="font-size: 10px; padding: 4px 10px;" onclick="sendQuickPrompt('SMC Bitcoin ne kya setup identify kiya hai?')">🧠 "SMC Bitcoin setup kya hai?"</button>
                    <button class="jarvis-btn" style="font-size: 10px; padding: 4px 10px; border-color: rgba(34,197,94,0.4);" onclick="sendQuickPrompt('Buy Bitcoin 0.02 lot')">⚡ "Buy Bitcoin 0.02 Lot"</button>
                `;
