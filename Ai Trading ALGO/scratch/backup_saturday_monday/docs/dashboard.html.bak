                    <!-- Alert 5 -->
                    <div class="alert-feed-item alert-item-completed">
                        <span style="width: 8px; height: 8px; border-radius: 50%; background: #a855f7; margin-top: 5px; flex-shrink: 0; box-shadow: 0 0 6px rgba(168,85,247,0.6);"></span>
                        <div style="flex: 1;">
