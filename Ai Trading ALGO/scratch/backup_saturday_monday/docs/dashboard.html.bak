        </main>
    </div>

    <!-- Master Scripts -->
    <script>
// === SCRIPT BLOCK 1 ===

        let currentAsset = "XAUUSD";
        let currentChartMode = "XAUUSD"; // 'XAUUSD', 'BTCUSD', 'DUAL'
        let currentChartTimeframe = "5"; // '1', '5', '15', '60', '240', 'D'
        let cachedHistoryData = null;
        let cachedAccountsData = null;
        let cachedAdminConfig = null;
        let activeHistoryFilter = "ALL";
        let activeAccountFilter = "ALL";
        let sidebarCollapsed = false;

        function setChartMode(mode) {
            currentChartMode = mode;
            const btnXau = document.getElementById('btn-chart-xau');
            const btnBtc = document.getElementById('btn-chart-btc');
            const btnDual = document.getElementById('btn-chart-dual');
            const headerTitle = document.getElementById('chart-header-title');
            const headerIcon = document.getElementById('chart-header-icon');
            const execSymbol = document.getElementById('trade-exec-symbol');

            if (btnXau) btnXau.className = 'chart-tab-btn' + (mode === 'XAUUSD' ? ' active-gold' : '');
            if (btnBtc) btnBtc.className = 'chart-tab-btn' + (mode === 'BTCUSD' ? ' active-btc' : '');
            if (btnDual) btnDual.className = 'chart-tab-btn' + (mode === 'DUAL' ? ' active-dual' : '');

            if (mode === 'XAUUSD') {
                if (headerTitle) headerTitle.innerText = 'LIVE XAUUSD (GOLD) TRADING CHART';
                if (headerIcon) headerIcon.innerText = '🥇';
                if (execSymbol) execSymbol.value = 'XAUUSD';
            } else if (mode === 'BTCUSD') {
                if (headerTitle) headerTitle.innerText = 'LIVE BTCUSD (BITCOIN) TRADING CHART';
                if (headerIcon) headerIcon.innerText = '₿';
                if (execSymbol) execSymbol.value = 'BTCUSD';
            } else if (mode === 'DUAL') {
                if (headerTitle) headerTitle.innerText = 'SPLIT DUAL CHART: 🥇 XAUUSD & ₿ BITCOIN';
                if (headerIcon) headerIcon.innerText = '⚡';
            }

            onTradeConsoleAssetChange(false);
            renderTradingViewChart();
        }

        function setChartTimeframe(tf) {
            currentChartTimeframe = tf;
            const tfList = ['1', '5', '15', '60', '240', 'D'];
            tfList.forEach(t => {
                const el = document.getElementById('tf-' + t);
                if (el) {
                    if (t === tf) {
                        el.className = 'chart-tab-btn ' + (currentChartMode === 'BTCUSD' ? 'active-btc' : 'active-gold');
                    } else {
                        el.className = 'chart-tab-btn';
                    }
                }
            });
            renderTradingViewChart();
        }

        function renderTradingViewChart() {
            const container = document.getElementById('chart-embed-wrapper');
            if (!container) return;

            const interval = currentChartTimeframe || '5';

            if (currentChartMode === 'DUAL') {
                container.innerHTML = `
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 12px; width: 100%; min-height: 520px; box-sizing: border-box; padding: 4px;">
                        <div style="display: flex; flex-direction: column; background: #0c0f17; border-radius: 10px; overflow: hidden; border: 1px solid rgba(245,158,11,0.3); min-height: 500px;">
                            <div style="padding: 8px 14px; background: rgba(245,158,11,0.12); font-size: 13px; font-weight: 800; color: #fbbf24; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(245,158,11,0.2);">
                                <span>🥇 XAUUSD (Gold Spot • ${interval}m)</span>
                                <button class="btn" onclick="selectTradeConsoleSymbol('XAUUSD')" style="padding: 3px 10px; font-size: 11px; background: rgba(245,158,11,0.25); color: #fbbf24; border: 1px solid rgba(245,158,11,0.4); border-radius: 4px; cursor: pointer;">🎯 Trade Gold</button>
                            </div>
                            <div id="tv_chart_xau" style="width: 100%; height: 460px;"></div>
                        </div>
                        <div style="display: flex; flex-direction: column; background: #0c0f17; border-radius: 10px; overflow: hidden; border: 1px solid rgba(247,147,26,0.3); min-height: 500px;">
                            <div style="padding: 8px 14px; background: rgba(247,147,26,0.12); font-size: 13px; font-weight: 800; color: #f7931a; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(247,147,26,0.2);">
                                <span>₿ BITCOIN (BTCUSD Perp • ${interval}m)</span>
                                <button class="btn" onclick="selectTradeConsoleSymbol('BTCUSD')" style="padding: 3px 10px; font-size: 11px; background: rgba(247,147,26,0.25); color: #f7931a; border: 1px solid rgba(247,147,26,0.4); border-radius: 4px; cursor: pointer;">🎯 Trade Bitcoin</button>
                            </div>
                            <div id="tv_chart_btc" style="width: 100%; height: 460px;"></div>
                        </div>
                    </div>
                `;

                setTimeout(() => {
                    try {
                        if (typeof TradingView !== 'undefined') {
                            new TradingView.widget({
                                "autosize": true,
                                "symbol": "OANDA:XAUUSD",
                                "interval": interval,
                                "timezone": "Etc/UTC",
                                "theme": "dark",
                                "style": "1",
                                "locale": "en",
                                "toolbar_bg": "#0c0f17",
                                "enable_publishing": false,
                                "hide_side_toolbar": false,
                                "allow_symbol_change": true,
                                "container_id": "tv_chart_xau"
                            });
                            new TradingView.widget({
                                "autosize": true,
                                "symbol": "BINANCE:BTCUSDT",
                                "interval": interval,
                                "timezone": "Etc/UTC",
                                "theme": "dark",
                                "style": "1",
                                "locale": "en",
                                "toolbar_bg": "#0c0f17",
                                "enable_publishing": false,
                                "hide_side_toolbar": false,
                                "allow_symbol_change": true,
                                "container_id": "tv_chart_btc"
                            });
                        } else {
                            const xauEl = document.getElementById('tv_chart_xau');
                            const btcEl = document.getElementById('tv_chart_btc');
                            if (xauEl) xauEl.innerHTML = `<iframe src="https://s.tradingview.com/widgetembed/?symbol=OANDA%3AXAUUSD&interval=${interval}&theme=dark&style=1" style="width:100%;height:100%;border:none;"></iframe>`;
                            if (btcEl) btcEl.innerHTML = `<iframe src="https://s.tradingview.com/widgetembed/?symbol=BINANCE%3ABTCUSDT&interval=${interval}&theme=dark&style=1" style="width:100%;height:100%;border:none;"></iframe>`;
                        }
                    } catch(e) {
                        console.error("TradingView init error:", e);
                    }
                }, 50);

            } else {
                const sym = currentChartMode === 'BTCUSD' ? 'BINANCE:BTCUSDT' : 'OANDA:XAUUSD';
                const borderColor = currentChartMode === 'BTCUSD' ? 'rgba(247,147,26,0.3)' : 'rgba(245,158,11,0.3)';
                
                container.innerHTML = `
                    <div style="width: 100%; min-height: 520px; border-radius: 10px; overflow: hidden; border: 1px solid ${borderColor};">
                        <div id="tv_chart_single" style="width: 100%; height: 520px;"></div>
                    </div>
                `;

                setTimeout(() => {
                    try {
                        if (typeof TradingView !== 'undefined') {
                            new TradingView.widget({
                                "autosize": true,
                                "symbol": sym,
                                "interval": interval,
                                "timezone": "Etc/UTC",
                                "theme": "dark",
                                "style": "1",
                                "locale": "en",
                                "toolbar_bg": "#0c0f17",
                                "enable_publishing": false,
                                "hide_side_toolbar": false,
                                "allow_symbol_change": true,
                                "save_image": false,
                                "container_id": "tv_chart_single"
                            });
                        } else {
                            const singleEl = document.getElementById('tv_chart_single');
                            const encodedSym = encodeURIComponent(sym);
                            if (singleEl) singleEl.innerHTML = `<iframe src="https://s.tradingview.com/widgetembed/?symbol=${encodedSym}&interval=${interval}&theme=dark&style=1" style="width:100%;height:520px;border:none;"></iframe>`;
                        }
                    } catch(e) {
                        console.error("TradingView init error:", e);
                    }
                }, 50);
            }
        }

        function renderCockpitAccountsStrip(accounts) {
            const container = document.getElementById('cockpit-accounts-strip');
            const countBadge = document.getElementById('cockpit-accounts-count-badge');
            if (!container || !accounts) return;

            const accKeys = Object.keys(accounts);
            if (countBadge) countBadge.innerText = `${accKeys.length} ACTIVE MT5`;

            if (accKeys.length === 0) {
                container.innerHTML = `
                    <div style="grid-column: 1 / -1; padding: 16px; background: rgba(239,68,68,0.1); border: 1px dashed rgba(239,68,68,0.3); border-radius: 8px; text-align: center; color: #fca5a5; font-size: 13px;">
                        ⚠️ No connected MT5 accounts detected. Open Account Management to connect and configure live trading accounts.
                    </div>
                `;
                return;
            }

            container.innerHTML = '';
            accKeys.forEach((k, idx) => {
                const a = accounts[k];
                const flag = getAccountFlag(a.currency, a.name);
                const currSym = getCurrencySymbol(a.currency);
                const eqStr = Number(a.equity || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
                const balStr = Number(a.balance || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
                const pnl = Number(a.total_floating_pnl || a.floating_pnl || 0);
                const pnlColor = pnl >= 0 ? 'var(--buy-green)' : 'var(--sell-red)';
                const allowedSyms = Array.isArray(a.allowed_symbols) ? a.allowed_symbols : ["XAUUSD"];
                const symLots = a.symbol_lots || {};
                const xauLot = symLots.XAUUSD !== undefined ? symLots.XAUUSD : (a.max_lot_size || 0.08);
                const btcLot = symLots.BTCUSD !== undefined ? symLots.BTCUSD : 0.01;

                const hasXau = allowedSyms.some(s => s.toUpperCase().includes('XAU') || s.toUpperCase().includes('GOLD'));
                const hasBtc = allowedSyms.some(s => s.toUpperCase().includes('BTC') || s.toUpperCase().includes('BITCOIN'));

                const card = document.createElement('div');
                card.className = 'cockpit-acc-card';
                card.onclick = () => selectCockpitAccountForTrading(k);

                let badgeHtml = '';
                if (hasXau) {
                    badgeHtml += `<span style="background: rgba(245,158,11,0.18); border: 1px solid rgba(245,158,11,0.4); color: #fbbf24; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 6px;">🥇 GOLD (${xauLot}L)</span> `;
                }
                if (hasBtc) {
                    badgeHtml += `<span style="background: rgba(247,147,26,0.2); border: 1px solid rgba(247,147,26,0.5); color: #f7931a; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 6px;">₿ BITCOIN (${btcLot}L)</span> `;
                }

                card.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 18px;">${flag}</span>
                            <div>
                                <div style="font-size: 13px; font-weight: 800; color: #fff; max-width: 170px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${a.name}">
                                    ${a.name || 'Account #' + (idx+1)}
                                </div>
                                <div style="font-size: 10px; color: var(--text-muted); font-family: var(--font-mono);">
                                    ID: <strong>${a.login || k}</strong>
                                </div>
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <span class="badge-live" style="font-size: 9px; padding: 1px 6px; ${a.mode === 'REAL' ? 'background: rgba(245,158,11,0.2); color: #fbbf24; border-color: rgba(245,158,11,0.4);' : ''}">${a.mode || 'DEMO'}</span>
                            <div style="font-size: 9px; color: var(--buy-green); margin-top: 2px; font-weight: 700;">🟢 LIVE</div>
                        </div>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; padding: 6px 10px; background: rgba(0,0,0,0.3); border-radius: 6px;">
                        <div>
                            <div style="font-size: 9px; color: var(--text-muted); text-transform: uppercase;">Live Equity</div>
                            <div style="font-size: 14px; font-weight: 800; color: #38bdf8; font-family: var(--font-mono);">${currSym}${eqStr}</div>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-size: 9px; color: var(--text-muted); text-transform: uppercase;">Float PnL</div>
                            <div style="font-size: 12px; font-weight: 800; color: ${pnlColor}; font-family: var(--font-mono);">${pnl >= 0 ? '+' : ''}${currSym}${pnl.toFixed(2)}</div>
                        </div>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 6px;">
                        <div style="display: flex; gap: 4px; flex-wrap: wrap;">
                            ${badgeHtml}
                        </div>
                        <button class="btn" style="padding: 3px 8px; font-size: 10px; background: rgba(56,189,248,0.15); color: #38bdf8; border: 1px solid rgba(56,189,248,0.3); border-radius: 4px; cursor: pointer;" title="Select account for manual trading">
                            🎯 Trade
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function selectCockpitAccountForTrading(accountId) {
            const accSelect = document.getElementById('trade-exec-account');
            if (accSelect) {
                accSelect.value = accountId;
                onTradeConsoleAccountChange();
                const consoleEl = document.querySelector('.quick-trade-console');
                if (consoleEl) {
                    consoleEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    consoleEl.style.transition = 'all 0.5s';
                    consoleEl.style.boxShadow = '0 0 25px rgba(56, 189, 248, 0.5)';
                    setTimeout(() => { consoleEl.style.boxShadow = ''; }, 2000);
                }
            }
        }

        function selectTradeConsoleSymbol(symbol) {
            const symSelect = document.getElementById('trade-exec-symbol');
            if (symSelect) {
                symSelect.value = symbol;
                onTradeConsoleAssetChange(false);
            }
        }

        function updateTradeConsoleAccountsDropdown(accounts) {
            const select = document.getElementById('trade-exec-account');
            const assetSelect = document.getElementById('trade-exec-symbol');
            if (!select || !accounts) return;

            const currentSymbol = assetSelect ? assetSelect.value : (currentAsset || 'XAUUSD');
            const prevVal = select.value;
            const accKeys = Object.keys(accounts);

            select.innerHTML = '';
            
            // "ALL" option
            const allOpt = document.createElement('option');
            allOpt.value = 'ALL';
            allOpt.innerText = `🌟 All Permitted Accounts for ${currentSymbol}`;
            select.appendChild(allOpt);

            accKeys.forEach((k, idx) => {
                const a = accounts[k];
                const allowed = Array.isArray(a.allowed_symbols) ? a.allowed_symbols : ["XAUUSD"];
                const isAllowed = (currentSymbol === 'BTCUSD') 
                    ? allowed.some(s => s.toUpperCase().includes('BTC') || s.toUpperCase().includes('BITCOIN'))
                    : allowed.some(s => s.toUpperCase().includes('XAU') || s.toUpperCase().includes('GOLD'));

                const opt = document.createElement('option');
                opt.value = k;
                const symLots = a.symbol_lots || {};
                const lot = currentSymbol === 'BTCUSD' ? (symLots.BTCUSD || 0.01) : (symLots.XAUUSD || a.max_lot_size || 0.08);
                const currSym = getCurrencySymbol(a.currency);
                const eq = Number(a.equity || 0).toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0});

                opt.innerText = `${isAllowed ? '✅' : '⛔'} ${a.name || 'Account #' + (idx+1)} (${a.login || k}) - ${currSym}${eq} [${lot}L]`;
                if (!isAllowed) {
                    opt.style.color = '#9ca3af';
                }
                select.appendChild(opt);
            });

            if (prevVal && select.querySelector(`option[value="${prevVal}"]`)) {
                select.value = prevVal;
            } else {
                select.value = 'ALL';
            }
        }

        function onTradeConsoleAssetChange(updateChart = true) {
            const symbol = document.getElementById('trade-exec-symbol')?.value || 'XAUUSD';
            if (updateChart && currentChartMode !== 'DUAL') {
                setChartMode(symbol);
            }
            if (cachedAccountsData) {
                updateTradeConsoleAccountsDropdown(cachedAccountsData);
            }
            onTradeConsoleAccountChange();
        }

        function onTradeConsoleAccountChange() {
            const symbol = document.getElementById('trade-exec-symbol')?.value || 'XAUUSD';
            const accId = document.getElementById('trade-exec-account')?.value || 'ALL';
            const lotsInput = document.getElementById('trade-exec-lots');
            if (!lotsInput) return;

            if (accId !== 'ALL' && cachedAccountsData && cachedAccountsData[accId]) {
                const a = cachedAccountsData[accId];
                const symLots = a.symbol_lots || {};
                const lot = symbol === 'BTCUSD' ? (symLots.BTCUSD || 0.01) : (symLots.XAUUSD || a.max_lot_size || 0.08);
                lotsInput.value = lot;
            } else if (cachedAdminConfig && cachedAdminConfig.accounts) {
                if (accId !== 'ALL' && cachedAdminConfig.accounts[accId]) {
                    const a = cachedAdminConfig.accounts[accId];
                    const symLots = a.symbol_lots || {};
                    const lot = symbol === 'BTCUSD' ? (symLots.BTCUSD || 0.01) : (symLots.XAUUSD || a.max_lot_size || 0.08);
                    lotsInput.value = lot;
                } else {
                    lotsInput.value = symbol === 'BTCUSD' ? 0.05 : 0.08;
                }
            } else {
                lotsInput.value = symbol === 'BTCUSD' ? 0.05 : 0.08;
            }
        }

        async function executeManualTrade(action) {
            const symbol = document.getElementById('trade-exec-symbol')?.value || 'XAUUSD';
            const accountId = document.getElementById('trade-exec-account')?.value || 'ALL';
            const volume = parseFloat(document.getElementById('trade-exec-lots')?.value || 0.08);
            const toast = document.getElementById('trade-exec-toast');

            if (toast) {
                toast.style.display = 'block';
                toast.style.background = 'rgba(59, 130, 246, 0.2)';
                toast.style.border = '1px solid rgba(59, 130, 246, 0.5)';
                toast.style.color = '#93c5fd';
                toast.innerHTML = `⏳ Executing manual <strong>Chanakya_${action}</strong> for <strong>${volume} Lots</strong> of <strong>${symbol}</strong> on <strong>${accountId === 'ALL' ? 'All Permitted Accounts' : accountId}</strong>...`;
            }

            try {
                const res = await fetch('/api/trade/execute', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        action: action,
                        symbol: symbol,
                        account_id: accountId,
                        volume: volume
                    })
                });
                const data = await res.json();
                if (data.status === 'success') {
                    if (toast) {
                        toast.style.background = 'rgba(16, 185, 129, 0.2)';
                        toast.style.border = '1px solid rgba(16, 185, 129, 0.5)';
                        toast.style.color = '#6ee7b7';
                        let orderStr = '';
                        if (data.orders && data.orders.length > 0) {
                            orderStr = data.orders.map(o => `[${o.account_name || o.account_id}: Ticket #${o.ticket} @ ${o.price || 'Mkt'}]`).join(' ');
                        }
                        toast.innerHTML = `✅ <strong>Chanakya_${action} Executed Successfully!</strong> ${data.message} ${orderStr}`;
                    }
                } else {
                    if (toast) {
                        toast.style.background = 'rgba(239, 68, 68, 0.2)';
                        toast.style.border = '1px solid rgba(239, 68, 68, 0.5)';
                        toast.style.color = '#fca5a5';
                        toast.innerHTML = `❌ <strong>Order Failed / Filtered:</strong> ${data.error || data.message || 'Execution error'}`;
                    }
                }
            } catch (err) {
                if (toast) {
                    toast.style.background = 'rgba(239, 68, 68, 0.2)';
                    toast.style.border = '1px solid rgba(239, 68, 68, 0.5)';
                    toast.style.color = '#fca5a5';
                    toast.innerHTML = `❌ <strong>Network / Server Error:</strong> ${err.message}`;
                }
            }

            fetchLiveStatus();
            setTimeout(() => {
                if (toast) toast.style.display = 'none';
            }, 8000);
        }

        function toggleSidebar() {
            const panel = document.getElementById('sidebarPanel');
            const icon = document.getElementById('sidebarToggleIcon');
            sidebarCollapsed = !sidebarCollapsed;
            if (panel) {
                if (sidebarCollapsed) {
                    panel.classList.add('collapsed');
                    if (icon) icon.innerText = '▶';
                } else {
                    panel.classList.remove('collapsed');
                    if (icon) icon.innerText = '◀';
                }
            }
        }

        let priceEventSource = null;
        let lastLiveTicks = null;

        function applyLiveTickUpdate(ticks) {
            if (!ticks) return;
            lastLiveTicks = ticks;

            // Update Gold sidebar pulse ticker
            if (ticks.XAUUSD) {
                const goldPrice = (ticks.XAUUSD.price || '0.00').toString().startsWith('$') ? ticks.XAUUSD.price : `$${ticks.XAUUSD.price}`;
                const sideGold = document.getElementById('side-gold-bid');
                if (sideGold) sideGold.innerText = goldPrice;
                const sideGoldSpr = document.getElementById('side-gold-spread');
                if (sideGoldSpr && ticks.XAUUSD.spread !== undefined) sideGoldSpr.innerText = `${ticks.XAUUSD.spread} pts`;
            }

            // Update Bitcoin sidebar pulse ticker
            if (ticks.BTCUSD) {
                const btcPrice = (ticks.BTCUSD.price || '0.00').toString().startsWith('$') ? ticks.BTCUSD.price : `$${ticks.BTCUSD.price}`;
                const sideBtc = document.getElementById('side-btc-bid');
                if (sideBtc) sideBtc.innerText = btcPrice;
                const sideBtcSpr = document.getElementById('side-btc-spread');
                if (sideBtcSpr && ticks.BTCUSD.spread !== undefined) sideBtcSpr.innerText = `${ticks.BTCUSD.spread} pts`;
            }

            // Update Main Cockpit Header Price & Spread for Current Asset
            const symTick = (currentAsset === 'BTCUSD') ? ticks.BTCUSD : ticks.XAUUSD;
            if (symTick && (currentAsset === 'XAUUSD' || currentAsset === 'BTCUSD')) {
                const displayPrice = (symTick.price || '0.00').toString().startsWith('$') ? symTick.price : `$${symTick.price}`;
                const elPrice = document.getElementById('asset-price');
                const elSpread = document.getElementById('spread-val');
                if (elPrice) {
                    elPrice.innerHTML = `${displayPrice} <span style="font-size: 14px; color: var(--buy-green)">USD</span>`;
                }
                if (elSpread && symTick.spread !== undefined) {
                    elSpread.innerText = `Spread: ${symTick.spread} pts`;
                }
            }

            // Update Chart Live Ticker
            const chartTicker = document.getElementById('chart-live-ticker');
            if (chartTicker && ticks.XAUUSD && ticks.BTCUSD) {
                const xauPrice = ticks.XAUUSD.price || '...';
                const btcPrice = ticks.BTCUSD.price || '...';
                if (currentChartMode === 'DUAL') {
                    chartTicker.innerHTML = `🥇 XAU: $${xauPrice} &nbsp;|&nbsp; ₿ BTC: $${btcPrice}`;
                } else if (currentChartMode === 'BTCUSD') {
                    chartTicker.innerHTML = `₿ BTCUSD Bid: $${btcPrice}`;
                } else {
                    chartTicker.innerHTML = `🥇 XAUUSD Bid: $${xauPrice}`;
                }
            }
        }

        async function fetchFastTicks() {
            try {
                const res = await fetch('/api/ticks');
                if (res.ok) {
                    const ticks = await res.json();
                    applyLiveTickUpdate(ticks);
                }
            } catch(e) {}
        }

        function setupLivePriceStream() {
            if (window.EventSource) {
                try {
                    if (priceEventSource) priceEventSource.close();
                    priceEventSource = new EventSource('/api/price-stream');
                    priceEventSource.onmessage = (e) => {
                        try {
                            const ticks = JSON.parse(e.data);
                            applyLiveTickUpdate(ticks);
                        } catch(err) {}
                    };
                    priceEventSource.onerror = () => {
                        if (priceEventSource) priceEventSource.close();
                        setTimeout(setupLivePriceStream, 2000);
                    };
                } catch(e) {}
            }
            // Ultra-fast 100ms background polling for instant zero-lag price updates
            setInterval(fetchFastTicks, 100);
        }

        function renderModelStatusPanel(asset) {
            const container = document.getElementById('model-status-list');
            if (!container) return;

            const isBtc = asset === 'BTCUSD';
            const models = isBtc ? [
                { name: "SMC & ICT Specialist (v4.2)", icon: "⚡", color: "#38bdf8", sub: "Bitcoin Liquidity Sweeps & Order Blocks • M15/H1", agentName: "SMC & ICT Specialist" },
                { name: "Trend & Momentum Engine (v2.1)", icon: "📈", color: "#34d399", sub: "BTC Multi-TF EMA Clouds & Ribbon Thrust • H4/H1", agentName: "Trend & Momentum" },
                { name: "Fibonacci & Golden Pocket (v3.0)", icon: "📐", color: "#fbbf24", sub: "Bitcoin 0.618 OTE & Harmonics • H1/M15", agentName: "Fibonacci & Golden Pocket" },
                { name: "Volume Profile & VWAP (v2.4)", icon: "📊", color: "#ec4899", sub: "Crypto Intraday POC & Value Area Absorption • M15", agentName: "Volume Profile & VWAP" },
                { name: "Tick / Order Flow Aggressor (v3.1)", icon: "⚡", color: "#a855f7", sub: "Bitcoin Ask-Lifters vs Bid-Hitters • Live Ticks", agentName: "Tick / Order Flow Aggressor" }
            ] : [
                { name: "SMC & ICT Specialist (v4.2)", icon: "⚡", color: "#38bdf8", sub: "Gold Liquidity Sweep & Order Blocks • M15/H1", agentName: "SMC & ICT Specialist" },
                { name: "Trend & Momentum Engine (v2.1)", icon: "📈", color: "#34d399", sub: "Gold Multi-TF EMA Clouds & Ribbon Thrust • H4/H1", agentName: "Trend & Momentum" },
                { name: "Fibonacci & Golden Pocket (v3.0)", icon: "📐", color: "#fbbf24", sub: "Gold 0.618 OTE & Extension Harmonics • H1/M15", agentName: "Fibonacci & Golden Pocket" },
                { name: "Volume Profile & VWAP (v2.4)", icon: "📊", color: "#ec4899", sub: "Gold Intraday POC & Value Area Absorption • M15", agentName: "Volume Profile & VWAP" },
                { name: "Tick / Order Flow Aggressor (v3.1)", icon: "⚡", color: "#a855f7", sub: "Gold Ask-Lifters vs Bid-Hitters • Live Ticks", agentName: "Tick / Order Flow Aggressor" }
            ];

            container.innerHTML = '';
            models.forEach(m => {
                const row = document.createElement('div');
                row.className = 'model-status-row';
                row.innerHTML = `
                    <div class="model-name-group">
                        <div class="model-icon-avatar" style="color: ${m.color};">${m.icon}</div>
                        <div>
                            <div style="font-size: 13px; font-weight: 700; color: #fff;">${m.name}</div>
                            <div style="font-size: 11px; color: var(--text-sub);">${m.sub}</div>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span class="badge-status-active">🟢 Active</span>
                        <span style="font-size: 12px; font-family: var(--font-mono); color: #94a3b8;">99.9%</span>
                        <button class="agent-discuss-btn" onclick="discussAgent('${m.agentName}', '${m.agentName}')">💬 Ask</button>
                    </div>
                `;
                container.appendChild(row);
            });
        }

        function updateQuickPromptChips(asset) {
            const container = document.getElementById('quick-prompts-container');
            if (!container) return;

            const isBtc = asset === 'BTCUSD';
            if (isBtc) {
                container.innerHTML = `
