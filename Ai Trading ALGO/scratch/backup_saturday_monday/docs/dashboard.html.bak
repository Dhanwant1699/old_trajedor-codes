            <!-- 6. ADMIN & RISK MATRIX VIEW -->
            <div id="admin-view-container" style="display: none; margin-bottom: 24px;">
                <div class="consensus-banner" style="margin-bottom: 20px;">
                    <div class="consensus-title">
                        <h2>⚙️ Chief Risk Officer (CRO) Admin & Armor Matrix</h2>
                        <div style="font-size: 13px; color: var(--text-muted);">Global lot sizing, dynamic spread shields, max drawdowns, and automated lockout parameters.</div>
                    </div>
                </div>
                <div class="terminal-card" style="margin-bottom: 16px;">
                    <div style="font-size: 14px; font-weight: 800; color: #fff; margin-bottom: 14px;">Live System Diagnostics & Engine Logs</div>
                    <div id="admin-system-logs" style="background: rgba(0,0,0,0.5); padding: 14px; border-radius: 8px; font-family: var(--font-mono); font-size: 11px; max-height: 300px; overflow-y: auto; color: #38bdf8;">
                        [SYSTEM READY] Autonomous Multi-Agent Trading Engine active. 14 Models synchronized.
                    </div>
                </div>
