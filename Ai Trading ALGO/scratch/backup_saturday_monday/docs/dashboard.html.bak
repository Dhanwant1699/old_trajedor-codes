                        <span id="alert-pill-critical" onclick="filterAlerts('CRITICAL')" style="font-size: 11px; background: rgba(255,255,255,0.03); padding: 3px 8px; border-radius: 6px; color: var(--text-muted); cursor: pointer;">Critical</span>
                        <span id="alert-pill-resolved" onclick="filterAlerts('RESOLVED')" style="font-size: 11px; background: rgba(255,255,255,0.03); padding: 3px 8px; border-radius: 6px; color: var(--text-muted); cursor: pointer;">Resolved</span>
                    </div>
