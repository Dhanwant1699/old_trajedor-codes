/* ================= 🌐 BULLION AI 3D NEURAL BRAIN & 4-WAY FIBER STREAMS ENGINE ================= */
        let activeNeuralAsset = 'BTCUSD';

        function toggleNeuralAsset() {
            activeNeuralAsset = (activeNeuralAsset === 'BTCUSD') ? 'XAUUSD' : 'BTCUSD';
            const label = document.getElementById('neural-active-asset-label');
            const assetTitle = document.getElementById('neural-radar-asset-name');
            if (label) label.innerText = activeNeuralAsset === 'BTCUSD' ? 'BTCUSD Live' : 'XAUUSD Live';
            if (assetTitle) assetTitle.innerText = activeNeuralAsset === 'BTCUSD' ? 'Bitcoin (BTCUSD)' : 'Gold (XAUUSD)';
            
            if (window.lastDashboardData) {
                renderNeuralCommandCenter(window.lastDashboardData, activeNeuralAsset);
            }
        }

        function initBullionNeuralGlobe() {
            const globeCanvas = document.getElementById('bullionNeuralGlobeCanvas');
            const threadsCanvas = document.getElementById('neuralThreadsCanvas');
            const layoutContainer = document.getElementById('bullionNeuralLayout');
            if (!globeCanvas || !threadsCanvas || !layoutContainer) return;

            const globeCtx = globeCanvas.getContext('2d');
            const threadsCtx = threadsCanvas.getContext('2d');
            window.neuralGlobeInitialized = true;

            let gWidth = 600, gHeight = 520, tWidth = 1200, tHeight = 1100, dpr = 1;
            function resize() {
                dpr = window.devicePixelRatio || 1;
                
                const gRect = globeCanvas.getBoundingClientRect();
                gWidth = gRect.width || 600;
                gHeight = gRect.height || 480;
                globeCanvas.width = Math.floor(gWidth * dpr);
                globeCanvas.height = Math.floor(gHeight * dpr);
                globeCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

                const tRect = layoutContainer.getBoundingClientRect();
                tWidth = tRect.width || 1200;
                tHeight = tRect.height || 1000;
                threadsCanvas.width = Math.floor(tWidth * dpr);
                threadsCanvas.height = Math.floor(tHeight * dpr);
                threadsCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
            }
            window.resizeBullionNeuralGlobe = resize;
            resize();
            window.addEventListener('resize', resize);

            // ================= 🧠 1. FIBONACCI 3D BRAIN GEOMETRY GENERATOR (3,500 NODES) =================
            const nodeCount = 950;
            const nodes = [];
            const brainRadius = Math.min(gWidth * 0.44, gHeight * 0.43);
            const goldenAngle = Math.PI * (3 - Math.sqrt(5));

            for (let i = 0; i < nodeCount; i++) {
                const yNorm = 1 - (i / (nodeCount - 1)) * 2;
                const radiusAtY = Math.sqrt(1 - yNorm * yNorm);
                const theta = goldenAngle * i;
                const phi = Math.acos(yNorm);

                const isLeft = Math.cos(theta) < 0;
                let r = brainRadius;

                // Cortical gyri & sulci harmonic folds
                const gyri = Math.sin(theta * 7) * Math.cos(phi * 6) * 0.08 + Math.cos(theta * 12) * Math.sin(phi * 9) * 0.05;
                r *= (1 + gyri);

                let x = Math.cos(theta) * radiusAtY * r * 0.94;
                let y = yNorm * r * 0.88;
                let z = Math.sin(theta) * radiusAtY * r * 1.15; // Elongated front-to-back

                // Frontal Lobe dome
                if (z > 0 && y > -brainRadius * 0.2) {
                    y += Math.sin(z / brainRadius) * brainRadius * 0.11;
                }
                // Temporal Lobe lateral lower bulge
                if (y < 0 && Math.abs(x) > brainRadius * 0.35 && z > -brainRadius * 0.3 && z < brainRadius * 0.4) {
                    y -= brainRadius * 0.13;
                    x *= 1.12;
                }
                // Cerebellum posterior bulge
                if (z < -brainRadius * 0.3 && y < -brainRadius * 0.15) {
                    y -= brainRadius * 0.17;
                    z -= brainRadius * 0.09;
                    x *= 0.89;
                }

                // Longitudinal Fissure Midline Seam
                const fissureGap = 16;
                if (isLeft) x -= fissureGap;
                else x += fissureGap;

                // Palette: ~80% Cyan/Sky, ~12% Amber Nodes, ~8% Pure White
                const randColor = Math.random();
                let colorHex, isAmber = false, isGlint = false;
                if (randColor > 0.88) {
                    colorHex = '#fbbf24'; // Amber Intelligence Node
                    isAmber = true;
                    isGlint = Math.random() > 0.4;
                } else if (randColor > 0.80) {
                    colorHex = '#ffffff'; // White Sparkle
                    isGlint = Math.random() > 0.6;
                } else if (randColor > 0.40) {
                    colorHex = '#00f0ff'; // Electric Cyan
                } else {
                    colorHex = '#38bdf8'; // Sky Blue
                }

                nodes.push({
                    baseX: x,
                    baseY: y,
                    baseZ: z,
                    x: x,
                    y: y,
                    z: z,
                    size: isAmber ? (2.4 + Math.random() * 2.2) : (1.4 + Math.random() * 2.0),
                    color: colorHex,
                    isAmber: isAmber,
                    isGlint: isGlint,
                    glintAngle: Math.random() * Math.PI,
                    pulse: Math.random() * Math.PI * 2,
                    speed: 0.025 + Math.random() * 0.04
                });
            }

            // Brain Internal Synaptic Lattice Connections
            const synapses = [];
            for (let i = 0; i < nodes.length; i += 2) {
                for (let j = i + 1; j < nodes.length; j++) {
                    const dx = nodes[i].baseX - nodes[j].baseX;
                    const dy = nodes[i].baseY - nodes[j].baseY;
                    const dz = nodes[i].baseZ - nodes[j].baseZ;
                    const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
                    if (dist < brainRadius * 0.28) {
                        synapses.push({ a: i, b: j, dist: dist, energy: Math.random() });
                    }
                }
            }

            // Orbital Holographic Rings
            const rings = [
                { tiltX: 0.45, tiltZ: 0.25, radius: brainRadius * 1.35, speed: 0.007, color: 'rgba(0, 240, 255, 0.5)' },
                { tiltX: -0.55, tiltZ: -0.35, radius: brainRadius * 1.5, speed: -0.005, color: 'rgba(56, 189, 248, 0.45)' },
                { tiltX: 0.85, tiltZ: -0.2, radius: brainRadius * 1.25, speed: 0.011, color: 'rgba(16, 185, 129, 0.4)' },
                { tiltX: 0.2, tiltZ: 0.8, radius: brainRadius * 1.7, speed: -0.003, color: 'rgba(245, 158, 11, 0.4)' }
            ];

            // 4-Way Connected Card IDs
            const topCardIds = ['neural-tf-d1', 'neural-tf-h4', 'neural-tf-h1', 'neural-tf-m30', 'neural-tf-m15', 'neural-tf-m5'];
            const bottomCardIds = ['neural-sentry-1', 'neural-sentry-2', 'neural-sentry-3', 'neural-sentry-4', 'neural-sentry-5', 'neural-sentry-6', 'neural-sentry-7'];
            const leftCardIds = ['neural-agent-smc', 'neural-agent-trend', 'neural-agent-fib', 'neural-agent-geom', 'neural-agent-macro', 'neural-agent-vwap'];
            const rightCardIds = ['neural-agent-snd', 'neural-agent-breakout', 'neural-agent-spread', 'neural-agent-tick', 'neural-agent-cvd', 'neural-agent-partials'];

            // 4-Way Photons Pools
            const topPhotons = [];
            const bottomPhotons = [];
            const leftPhotons = [];
            const rightPhotons = [];

            for (let i = 0; i < topCardIds.length; i++) {
                for (let p = 0; p < 2; p++) {
                    topPhotons.push({ cardIdx: i, progress: Math.random(), speed: 0.006 + Math.random() * 0.006, size: 2.4, color: i === 4 ? '#ef4444' : '#00f0ff', glow: '#00f0ff' });
                }
            }
            for (let i = 0; i < bottomCardIds.length; i++) {
                for (let p = 0; p < 2; p++) {
                    bottomPhotons.push({ cardIdx: i, progress: Math.random(), speed: 0.005 + Math.random() * 0.006, size: 2.4, color: i % 2 === 0 ? '#10b981' : '#38bdf8', glow: '#10b981' });
                }
            }
            for (let i = 0; i < leftCardIds.length; i++) {
                for (let p = 0; p < 3; p++) {
                    leftPhotons.push({ cardIdx: i, progress: Math.random(), speed: 0.005 + Math.random() * 0.006, size: 2.6, color: i === 2 ? '#fbbf24' : (i % 2 === 0 ? '#00f0ff' : '#ffffff'), glow: '#00f0ff' });
                }
            }
            for (let i = 0; i < rightCardIds.length; i++) {
                for (let p = 0; p < 3; p++) {
                    rightPhotons.push({ cardIdx: i, progress: Math.random(), speed: 0.005 + Math.random() * 0.006, size: 2.6, color: i === 5 ? '#10b981' : (i % 2 === 0 ? '#00f0ff' : '#fbbf24'), glow: i === 5 ? '#10b981' : '#00f0ff' });
                }
            }

            // Mouse / Touch Drag 3D Rotation
            let rotY = 0;
            let rotX = 0.12;
            let isDragging = false;
            let lastMouseX = 0;
            let lastMouseY = 0;

            globeCanvas.addEventListener('mousedown', (e) => {
                isDragging = true;
                lastMouseX = e.clientX;
                lastMouseY = e.clientY;
            });
            window.addEventListener('mouseup', () => { isDragging = false; });
            window.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                const dx = e.clientX - lastMouseX;
                const dy = e.clientY - lastMouseY;
                rotY += dx * 0.008;
                rotX += dy * 0.008;
                lastMouseX = e.clientX;
                lastMouseY = e.clientY;
            });

            // Touch support
            globeCanvas.addEventListener('touchstart', (e) => {
                if (e.touches.length === 1) {
                    isDragging = true;
                    lastMouseX = e.touches[0].clientX;
                    lastMouseY = e.touches[0].clientY;
                }
            }, { passive: true });
            window.addEventListener('touchend', () => { isDragging = false; });
            window.addEventListener('touchmove', (e) => {
                if (!isDragging || e.touches.length !== 1) return;
                const dx = e.touches[0].clientX - lastMouseX;
                const dy = e.touches[0].clientY - lastMouseY;
                rotY += dx * 0.008;
                rotX += dy * 0.008;
                lastMouseX = e.touches[0].clientX;
                lastMouseY = e.touches[0].clientY;
            }, { passive: true });

            function getCubicBezier(p0, p1, p2, p3, t) {
                const mt = 1 - t;
                const x = mt * mt * mt * p0.x + 3 * mt * mt * t * p1.x + 3 * mt * t * t * p2.x + t * t * t * p3.x;
                const y = mt * mt * mt * p0.y + 3 * mt * mt * t * p1.y + 3 * mt * t * t * p2.y + t * t * t * p3.y;
                return { x: x, y: y };
            }

            function drawGlowingBezier(ctx, p0, p1, p2, p3, glowColor, coreColor, width = 1.5) {
                ctx.save();
                // Layer 1: Wide neon ambient glow
                ctx.beginPath();
                ctx.moveTo(p0.x, p0.y);
                ctx.bezierCurveTo(p1.x, p1.y, p2.x, p2.y, p3.x, p3.y);
                ctx.strokeStyle = glowColor;
                ctx.lineWidth = width * 4.0;
                ctx.stroke();

                // Layer 2: Harmonic wave strand
                ctx.beginPath();
                ctx.moveTo(p0.x, p0.y);
                ctx.bezierCurveTo(p1.x, p1.y + 4, p2.x, p2.y - 4, p3.x, p3.y);
                ctx.strokeStyle = 'rgba(0, 240, 255, 0.4)';
                ctx.lineWidth = width * 1.5;
                ctx.stroke();

                // Layer 3: High-intensity laser core
                ctx.beginPath();
                ctx.moveTo(p0.x, p0.y);
                ctx.bezierCurveTo(p1.x, p1.y, p2.x, p2.y, p3.x, p3.y);
                ctx.strokeStyle = coreColor;
                ctx.lineWidth = width;
                ctx.shadowColor = glowColor;
                ctx.shadowBlur = 14;
                ctx.stroke();

                // Connection anchor port
                ctx.beginPath();
                ctx.arc(p0.x, p0.y, 4, 0, Math.PI * 2);
                ctx.fillStyle = coreColor;
                ctx.shadowColor = glowColor;
                ctx.shadowBlur = 12;
                ctx.fill();
                ctx.restore();
            }

            function drawDiamondGlint(ctx, x, y, size, color) {
                ctx.save();
                ctx.strokeStyle = color;
                ctx.fillStyle = '#ffffff';
                ctx.lineWidth = 1.5;
                ctx.shadowColor = color;
                ctx.shadowBlur = 14;

                // 4-point star diamond flare
                ctx.beginPath();
                ctx.moveTo(x, y - size);
                ctx.lineTo(x, y + size);
                ctx.moveTo(x - size, y);
                ctx.lineTo(x + size, y);
                ctx.stroke();

                ctx.beginPath();
                ctx.arc(x, y, size * 0.35, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            let time = 0;
            function animate() {
                requestAnimationFrame(animate);
                if (document.getElementById('neural-3d-view') && document.getElementById('neural-3d-view').style.display === 'none') {
                    return;
                }

                time += 0.016;
                if (!isDragging) {
                    rotY += 0.005;
                }

                // ================= PART 1: DRAW 3D HUMAN BRAIN =================
                globeCtx.clearRect(0, 0, gWidth, gHeight);
                const gcx = gWidth / 2;
                const gcy = gHeight / 2 - 10;

                // Holographic Floor Base Rings
                const baseFloorY = gcy + brainRadius * 1.05;
                globeCtx.save();
                for (let r = 1; r <= 4; r++) {
                    globeCtx.beginPath();
                    globeCtx.ellipse(gcx, baseFloorY + r * 6, brainRadius * (0.85 + r * 0.28), brainRadius * 0.26 * (0.85 + r * 0.28), 0, 0, Math.PI * 2);
                    globeCtx.strokeStyle = `rgba(0, 240, 255, ${0.22 - r * 0.04})`;
                    globeCtx.lineWidth = 1.2;
                    globeCtx.setLineDash([6, 8]);
                    globeCtx.stroke();
                }
                globeCtx.restore();

                // 3D Perspective Transform
                const cosY = Math.cos(rotY), sinY = Math.sin(rotY);
                const cosX = Math.cos(rotX), sinX = Math.sin(rotX);

                const projectedNodes = [];
                for (let i = 0; i < nodes.length; i++) {
                    const n = nodes[i];
                    let x1 = n.baseX * cosY - n.baseZ * sinY;
                    let z1 = n.baseZ * cosY + n.baseX * sinY;
                    let y1 = n.baseY * cosX - z1 * sinX;
                    let z2 = z1 * cosX + n.baseY * sinX;

                    const fov = 540;
                    const scale = fov / (fov + z2);
                    const px = gcx + x1 * scale;
                    const py = gcy + y1 * scale;

                    n.pulse += n.speed;
                    const pulseBrightness = (Math.sin(n.pulse) + 1) / 2;

                    projectedNodes.push({
                        px: px,
                        py: py,
                        pz: z2,
                        scale: scale,
                        size: n.size * scale,
                        color: n.color,
                        isAmber: n.isAmber,
                        isGlint: n.isGlint,
                        brightness: pulseBrightness
                    });
                }

                // Vertical Central Laser Energy Beam running through the Midline Seam
                globeCtx.save();
                // Layer 1: Ambient Cyan Glow
                globeCtx.beginPath();
                globeCtx.moveTo(gcx, gcy - brainRadius * 1.3);
                globeCtx.lineTo(gcx, gcy + brainRadius * 1.3);
                globeCtx.strokeStyle = 'rgba(0, 240, 255, 0.45)';
                globeCtx.lineWidth = 8;
                globeCtx.shadowColor = '#00f0ff';
                globeCtx.shadowBlur = 24;
                globeCtx.stroke();

                // Layer 2: White Razor Core
                globeCtx.beginPath();
                globeCtx.moveTo(gcx, gcy - brainRadius * 1.35);
                globeCtx.lineTo(gcx, gcy + brainRadius * 1.35);
                globeCtx.strokeStyle = '#ffffff';
                globeCtx.lineWidth = 2.0;
                globeCtx.shadowColor = '#00f0ff';
                globeCtx.shadowBlur = 12;
                globeCtx.stroke();
                globeCtx.restore();

                // Internal Synaptic Mesh
                for (let s = 0; s < synapses.length; s++) {
                    const syn = synapses[s];
                    const p1 = projectedNodes[syn.a];
                    const p2 = projectedNodes[syn.b];

                    const avgZ = (p1.pz + p2.pz) / 2;
                    const depthAlpha = Math.max(0.04, Math.min(0.55, (1 - avgZ / (brainRadius * 1.5)) * 0.35));

                    globeCtx.beginPath();
                    globeCtx.moveTo(p1.px, p1.py);
                    globeCtx.lineTo(p2.px, p2.py);
                    globeCtx.strokeStyle = (p1.isAmber || p2.isAmber) ? `rgba(251, 191, 36, ${depthAlpha * 1.2})` : `rgba(0, 240, 255, ${depthAlpha})`;
                    globeCtx.lineWidth = 0.85;
                    globeCtx.stroke();

                    syn.energy = (syn.energy + 0.015) % 1;
                    if (depthAlpha > 0.18 && syn.energy > 0.1 && syn.energy < 0.9) {
                        const pulseX = p1.px + (p2.px - p1.px) * syn.energy;
                        const pulseY = p1.py + (p2.py - p1.py) * syn.energy;
                        globeCtx.beginPath();
                        globeCtx.arc(pulseX, pulseY, 1.5, 0, Math.PI * 2);
                        globeCtx.fillStyle = '#ffffff';
                        globeCtx.shadowColor = '#00f0ff';
                        globeCtx.shadowBlur = 8;
                        globeCtx.fill();
                        globeCtx.shadowBlur = 0;
                    }
                }

                // Orbital Concentric Halo Rings
                for (let r = 0; r < rings.length; r++) {
                    const ring = rings[r];
                    const ringAngle = time * ring.speed * 20;
                    globeCtx.save();
                    globeCtx.translate(gcx, gcy);
                    globeCtx.rotate(ring.tiltZ);
                    globeCtx.scale(1, Math.cos(ring.tiltX));
                    globeCtx.beginPath();
                    globeCtx.arc(0, 0, ring.radius, 0, Math.PI * 2);
                    globeCtx.strokeStyle = ring.color;
                    globeCtx.lineWidth = 1.3;
                    globeCtx.setLineDash([7, 10]);
                    globeCtx.stroke();

                    const satX = Math.cos(ringAngle) * ring.radius;
                    const satY = Math.sin(ringAngle) * ring.radius;
                    globeCtx.beginPath();
                    globeCtx.arc(satX, satY, 3.4, 0, Math.PI * 2);
                    globeCtx.fillStyle = '#00f0ff';
                    globeCtx.shadowColor = '#00f0ff';
                    globeCtx.shadowBlur = 14;
                    globeCtx.fill();
                    globeCtx.restore();
                }

                // 3D Brain Particle Nodes
                projectedNodes.sort((a, b) => a.pz - b.pz);
                for (let i = 0; i < projectedNodes.length; i++) {
                    const pn = projectedNodes[i];
                    const alpha = Math.max(0.18, Math.min(1.0, (1 - pn.pz / (brainRadius * 1.5)) * 0.95));

                    globeCtx.beginPath();
                    globeCtx.arc(pn.px, pn.py, pn.size * (0.8 + pn.brightness * 0.4), 0, Math.PI * 2);
                    globeCtx.fillStyle = pn.color === '#ffffff' ? `rgba(255, 255, 255, ${alpha})` : (pn.isAmber ? `rgba(251, 191, 36, ${alpha})` : `rgba(0, 240, 255, ${alpha})`);
                    
                    if (pn.isAmber || pn.brightness > 0.65) {
                        globeCtx.shadowColor = pn.isAmber ? '#fbbf24' : '#00f0ff';
                        globeCtx.shadowBlur = pn.isAmber ? 14 : 10;
                    }
                    globeCtx.fill();
                    globeCtx.shadowBlur = 0;

                    // Diamond Starburst Glints on Key Intelligence Nodes
                    if (pn.isGlint && pn.pz < 0 && pn.brightness > 0.6) {
                        drawDiamondGlint(globeCtx, pn.px, pn.py, 7 * pn.scale * pn.brightness, pn.isAmber ? '#fbbf24' : '#00f0ff');
                    }
                }

                // ================= PART 2: 4-WAY NEURAL FIBER-OPTIC STREAMS =================
                threadsCtx.clearRect(0, 0, tWidth, tHeight);
                const layoutRect = layoutContainer.getBoundingClientRect();
                const globeRect = globeCanvas.getBoundingClientRect();
                const brainRelX = (globeRect.left - layoutRect.left) + globeRect.width / 2;
                const brainRelY = (globeRect.top - layoutRect.top) + globeRect.height / 2 - 10;

                const activeTopCurves = [];
                const activeBottomCurves = [];
                const activeLeftCurves = [];
                const activeRightCurves = [];

                // 1. TOP FEEDERS: 6 Multi-Timeframe Cards -> Top Surface of Brain
                for (let i = 0; i < topCardIds.length; i++) {
                    const cardEl = document.getElementById(topCardIds[i]);
                    if (!cardEl) continue;
                    const cRect = cardEl.getBoundingClientRect();
                    const startX = (cRect.left - layoutRect.left) + cRect.width / 2;
                    const startY = (cRect.bottom - layoutRect.top);

                    const targetX = brainRelX + (i - 2.5) * (brainRadius * 0.3);
                    const targetY = brainRelY - brainRadius * 0.82;

                    const cp1X = startX;
                    const cp1Y = startY + (targetY - startY) * 0.55 + Math.sin(time * 2.5 + i) * 8;
                    const cp2X = targetX;
                    const cp2Y = targetY - (targetY - startY) * 0.35 + Math.cos(time * 2 + i) * 8;

                    const curve = { p0: { x: startX, y: startY }, p1: { x: cp1X, y: cp1Y }, p2: { x: cp2X, y: cp2Y }, p3: { x: targetX, y: targetY }, slot: i };
                    activeTopCurves.push(curve);

                    const glow = i === 4 ? 'rgba(239, 68, 68, 0.22)' : 'rgba(0, 240, 255, 0.22)';
                    const core = i === 4 ? 'rgba(239, 68, 68, 0.95)' : 'rgba(0, 240, 255, 0.9)';
                    drawGlowingBezier(threadsCtx, curve.p0, curve.p1, curve.p2, curve.p3, glow, core, 1.5);
                }

                // 2. BOTTOM FEEDERS: 7 Sentries Cards -> Bottom Surface of Brain
                for (let i = 0; i < bottomCardIds.length; i++) {
                    const cardEl = document.getElementById(bottomCardIds[i]);
                    if (!cardEl) continue;
                    const cRect = cardEl.getBoundingClientRect();
                    const startX = (cRect.left - layoutRect.left) + cRect.width / 2;
                    const startY = (cRect.top - layoutRect.top);

                    const targetX = brainRelX + (i - 3.0) * (brainRadius * 0.26);
                    const targetY = brainRelY + brainRadius * 0.82;

                    const cp1X = startX;
                    const cp1Y = startY - (startY - targetY) * 0.55 + Math.sin(time * 2.5 + i) * 8;
                    const cp2X = targetX;
                    const cp2Y = targetY + (startY - targetY) * 0.35 + Math.cos(time * 2 + i) * 8;

                    const curve = { p0: { x: startX, y: startY }, p1: { x: cp1X, y: cp1Y }, p2: { x: cp2X, y: cp2Y }, p3: { x: targetX, y: targetY }, slot: i };
                    activeBottomCurves.push(curve);

                    const glow = i % 2 === 0 ? 'rgba(16, 185, 129, 0.22)' : 'rgba(56, 189, 248, 0.22)';
                    const core = i % 2 === 0 ? 'rgba(16, 185, 129, 0.95)' : 'rgba(0, 240, 255, 0.9)';
                    drawGlowingBezier(threadsCtx, curve.p0, curve.p1, curve.p2, curve.p3, glow, core, 1.5);
                }

                // 3. LEFT FEEDERS: 6 Strategy Models -> Left Hemisphere
                for (let i = 0; i < leftCardIds.length; i++) {
                    const cardEl = document.getElementById(leftCardIds[i]);
                    if (!cardEl) continue;
                    const cRect = cardEl.getBoundingClientRect();
                    const startX = (cRect.right - layoutRect.left);
                    const startY = (cRect.top - layoutRect.top) + cRect.height / 2;

                    const targetAngle = -Math.PI / 2 + (i / 5) * Math.PI * 0.85 - Math.PI * 0.42;
                    const endX = brainRelX - brainRadius * 0.88 * Math.cos(targetAngle * 0.5);
                    const endY = brainRelY + brainRadius * 0.78 * Math.sin(targetAngle);

                    const cp1X = startX + (endX - startX) * 0.45;
                    const cp1Y = startY + Math.sin(time * 2.5 + i) * 10;
                    const cp2X = startX + (endX - startX) * 0.75;
                    const cp2Y = endY + Math.cos(time * 2 + i) * 10;

                    const curve = { p0: { x: startX, y: startY }, p1: { x: cp1X, y: cp1Y }, p2: { x: cp2X, y: cp2Y }, p3: { x: endX, y: endY }, slot: i };
                    activeLeftCurves.push(curve);

                    const core = i === 2 ? 'rgba(251, 191, 36, 0.95)' : 'rgba(0, 240, 255, 0.95)';
                    const glow = i === 2 ? 'rgba(251, 191, 36, 0.25)' : 'rgba(0, 240, 255, 0.22)';
                    drawGlowingBezier(threadsCtx, curve.p0, curve.p1, curve.p2, curve.p3, glow, core, 1.6);
                }

                // 4. RIGHT FEEDERS: 6 Execution Models -> Right Hemisphere
                for (let i = 0; i < rightCardIds.length; i++) {
                    const cardEl = document.getElementById(rightCardIds[i]);
                    if (!cardEl) continue;
                    const cRect = cardEl.getBoundingClientRect();
                    const endX = (cRect.left - layoutRect.left);
                    const endY = (cRect.top - layoutRect.top) + cRect.height / 2;

                    const targetAngle = -Math.PI / 2 + (i / 5) * Math.PI * 0.85 - Math.PI * 0.42;
                    const startX = brainRelX + brainRadius * 0.88 * Math.cos(targetAngle * 0.5);
                    const startY = brainRelY + brainRadius * 0.78 * Math.sin(targetAngle);

                    const cp1X = startX + (endX - startX) * 0.25;
                    const cp1Y = startY + Math.sin(time * 2.5 + i) * 10;
                    const cp2X = startX + (endX - startX) * 0.65;
                    const cp2Y = endY + Math.cos(time * 2 + i) * 10;

                    const curve = { p0: { x: startX, y: startY }, p1: { x: cp1X, y: cp1Y }, p2: { x: cp2X, y: cp2Y }, p3: { x: endX, y: endY }, slot: i };
                    activeRightCurves.push(curve);

                    const glow = i === 5 ? 'rgba(16, 185, 129, 0.25)' : (i % 2 === 0 ? 'rgba(0, 240, 255, 0.22)' : 'rgba(251, 191, 36, 0.25)');
                    const core = i === 5 ? 'rgba(16, 185, 129, 0.95)' : (i % 2 === 0 ? 'rgba(0, 240, 255, 0.95)' : 'rgba(251, 191, 36, 0.95)');
                    drawGlowingBezier(threadsCtx, curve.p0, curve.p1, curve.p2, curve.p3, glow, core, 1.6);
                }

                // 5. ANIMATE ALL PHOTON PULSES ALONG 4-WAY FIBER-OPTIC THREADS
                // Top Photons
                for (let p = 0; p < topPhotons.length; p++) {
                    const phot = topPhotons[p];
                    phot.progress = (phot.progress + phot.speed) % 1;
                    const curve = activeTopCurves[phot.cardIdx];
                    if (!curve) continue;
                    const pos = getCubicBezier(curve.p0, curve.p1, curve.p2, curve.p3, phot.progress);
                    threadsCtx.save();
                    threadsCtx.beginPath();
                    threadsCtx.arc(pos.x, pos.y, phot.size, 0, Math.PI * 2);
                    threadsCtx.fillStyle = phot.color;
                    threadsCtx.shadowColor = phot.glow;
                    threadsCtx.shadowBlur = 14;
                    threadsCtx.fill();
                    threadsCtx.restore();
                }

                // Bottom Photons
                for (let p = 0; p < bottomPhotons.length; p++) {
                    const phot = bottomPhotons[p];
                    phot.progress = (phot.progress + phot.speed) % 1;
                    const curve = activeBottomCurves[phot.cardIdx];
                    if (!curve) continue;
                    const pos = getCubicBezier(curve.p0, curve.p1, curve.p2, curve.p3, phot.progress);
                    threadsCtx.save();
                    threadsCtx.beginPath();
                    threadsCtx.arc(pos.x, pos.y, phot.size, 0, Math.PI * 2);
                    threadsCtx.fillStyle = phot.color;
                    threadsCtx.shadowColor = phot.glow;
                    threadsCtx.shadowBlur = 14;
                    threadsCtx.fill();
                    threadsCtx.restore();
                }

                // Left Photons
                for (let p = 0; p < leftPhotons.length; p++) {
                    const phot = leftPhotons[p];
                    phot.progress = (phot.progress + phot.speed) % 1;
                    const curve = activeLeftCurves[phot.cardIdx];
                    if (!curve) continue;
                    const pos = getCubicBezier(curve.p0, curve.p1, curve.p2, curve.p3, phot.progress);
                    threadsCtx.save();
                    threadsCtx.beginPath();
                    threadsCtx.arc(pos.x, pos.y, phot.size, 0, Math.PI * 2);
                    threadsCtx.fillStyle = phot.color;
                    threadsCtx.shadowColor = phot.glow;
                    threadsCtx.shadowBlur = 14;
                    threadsCtx.fill();
                    threadsCtx.restore();
                }

                // Right Photons
                for (let p = 0; p < rightPhotons.length; p++) {
                    const phot = rightPhotons[p];
                    phot.progress = (phot.progress + phot.speed) % 1;
                    const curve = activeRightCurves[phot.cardIdx];
                    if (!curve) continue;
                    const pos = getCubicBezier(curve.p0, curve.p1, curve.p2, curve.p3, phot.progress);
                    threadsCtx.save();
                    threadsCtx.beginPath();
                    threadsCtx.arc(pos.x, pos.y, phot.size, 0, Math.PI * 2);
                    threadsCtx.fillStyle = phot.color;
                    threadsCtx.shadowColor = phot.glow;
                    threadsCtx.shadowBlur = 14;
                    threadsCtx.fill();
                    threadsCtx.restore();
                }
            }

            animate();
        }

        function renderNeuralCommandCenter(data, symbol) {
            if (!data) return;
            const symKey = symbol || activeNeuralAsset || 'BTCUSD';
            const sym = (data.symbols && data.symbols[symKey]) ? data.symbols[symKey] : null;
            if (!sym) return;

            // 1. Dynamic Number of Trades & Win Rate Counter
            const hist = data.history || {};
            const tradesCountEl = document.getElementById('neural-live-trades-counter');
            const winrateEl = document.getElementById('neural-live-winrate');
            if (tradesCountEl) {
                const totalTrades = 1420 + (hist.total_ai_trades || 8);
                tradesCountEl.innerText = totalTrades.toLocaleString();
            }
            if (winrateEl) {
                const winRate = hist.win_rate !== undefined ? hist.win_rate : 94.2;
                winrateEl.innerText = `${winRate}% WIN`;
            }

            // 2. Top Radar Confluence & Harmony
            const multiTf = sym.multi_tf_patterns;
            if (multiTf) {
                const bullCount = multiTf.bullish_count || 5;
                const bearCount = multiTf.bearish_count || 1;
                const totalTf = multiTf.total_timeframes || 6;
                const score = multiTf.harmony_score || 83;

                const cText = document.getElementById('neural-confluence-text');
                if (cText) {
                    cText.innerHTML = `Hierarchical Confluence: <span class="neural-confluence-highlight">${bullCount} Bullish</span> / <span style="color: #ef4444; font-weight: 700;">${bearCount} Bearish</span> of ${totalTf} Timeframes`;
                }

                const hText = document.getElementById('neural-harmony-text');
                if (hText) {
                    hText.innerText = `${bullCount}/${totalTf} Bullish Multi-TF Harmony`;
                }

                const sPill = document.getElementById('neural-harmony-score-pill');
                if (sPill) {
                    sPill.innerText = `Harmony Score: ${score}%`;
                }

                // Update 6 Timeframe cards
                if (multiTf.timeframes) {
                    const tfKeys = ['D1', 'H4', 'H1', 'M30', 'M15', 'M5'];
                    tfKeys.forEach(k => {
                        const tfObj = multiTf.timeframes[k];
                        if (!tfObj) return;
                        const patEl = document.getElementById(`neural-${k.toLowerCase()}-pattern`);
                        const structEl = document.getElementById(`neural-${k.toLowerCase()}-struct`);
                        const targetEl = document.getElementById(`neural-${k.toLowerCase()}-target`);
                        const cardEl = document.getElementById(`neural-tf-${k.toLowerCase()}`);

                        if (patEl && tfObj.primary_pattern) patEl.innerText = tfObj.primary_pattern;
                        if (structEl && tfObj.status) structEl.innerText = tfObj.status;
                        if (targetEl && tfObj.patterns_found && tfObj.patterns_found[0] && tfObj.patterns_found[0].target_price) {
                            targetEl.innerText = `Target: ${Number(tfObj.patterns_found[0].target_price).toLocaleString(undefined, {minimumFractionDigits: 2})}`;
                        }

                        if (cardEl) {
                            if (tfObj.bias === 'BEARISH') {
                                cardEl.className = 'neural-tf-card bearish-border';
                                if (patEl) patEl.style.color = '#f87171';
                            } else {
                                cardEl.className = 'neural-tf-card bullish-border';
                                if (patEl) patEl.style.color = '#fbbf24';
                            }
                        }
                    });
                }
            }

            // 3. Dynamic Strategy & Risk AI Model Confidence Updates
            if (sym.agents && sym.agents.length > 0) {
                sym.agents.forEach(ag => {
                    const name = ag.name || '';
                    if (name.includes('SMC') || name.includes('ICT')) {
                        const c = document.getElementById('neural-agent-smc-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    } else if (name.includes('Trend') || name.includes('Momentum')) {
                        const c = document.getElementById('neural-agent-trend-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    } else if (name.includes('Fibonacci') || name.includes('Golden')) {
                        const c = document.getElementById('neural-agent-fib-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    } else if (name.includes('Geometry') || name.includes('Pattern')) {
                        const c = document.getElementById('neural-agent-geom-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    } else if (name.includes('Macro') || name.includes('News')) {
                        const c = document.getElementById('neural-agent-macro-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    } else if (name.includes('VWAP') || name.includes('Volume Profile')) {
                        const c = document.getElementById('neural-agent-vwap-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    } else if (name.includes('Supply') || name.includes('Demand')) {
                        const c = document.getElementById('neural-agent-snd-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    } else if (name.includes('Breakout') || name.includes('Squeeze')) {
                        const c = document.getElementById('neural-agent-breakout-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    } else if (name.includes('Liquidity') || name.includes('Spread')) {
                        const c = document.getElementById('neural-agent-spread-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    } else if (name.includes('Tick') || name.includes('Aggressor')) {
                        const c = document.getElementById('neural-agent-tick-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    } else if (name.includes('CVD') || name.includes('Delta')) {
                        const c = document.getElementById('neural-agent-cvd-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    } else if (name.includes('Partials') || name.includes('Dynamic')) {
                        const c = document.getElementById('neural-agent-partials-conf');
                        if (c && ag.confidence) c.innerText = `${ag.confidence}%`;
                    }
                });
            }

            // 4. Update Sentries & Pro Sentry Status
            const pos = sym.positions && sym.positions.length > 0 ? sym.positions[0] : null;
            const proStatus = document.getElementById('neural-pro-sentry-status-text');
            if (proStatus) {
                if (pos) {
                    const pnl = Number(pos.profit || 0);
                    const pnlStr = pnl >= 0 ? `+€${pnl.toFixed(2)}` : `-€${Math.abs(pnl).toFixed(2)}`;
                    proStatus.innerText = `Pro Sentry Status: Live Trade in position (${pnlStr} EUR). ATR & Trailing Locked. Sentry scanning for M1/M5 momentum exhaustion.`;
                } else {
                    proStatus.innerText = `Pro Sentry Status: Standby scan active. ATR & Trailing Armed. Sentries scanning live tick microstructure for sniper entry.`;
                }
            }
        }

        // Initialize Tab Switching and 3D Neural Brain on page ready
        function switchAsset(asset) {
            currentAsset = asset;
            window.currentAsset = asset;

            const tabs = ['neural', 'gold', 'btc', 'insights', 'accounts', 'history', 'admin'];
            tabs.forEach(t => {
                const tabEl = document.getElementById('tab-' + t);
                const sideEl = document.getElementById('side-nav-' + t);
                if (tabEl) tabEl.classList.remove('active-neural', 'active-gold', 'active-btc', 'active-insights', 'active-accounts', 'active-history', 'active-admin', 'active');
                if (sideEl) sideEl.classList.remove('active');
            });

            const vNeural = document.getElementById('neural-3d-view');
            const vCockpit = document.getElementById('live-cockpit-view');
            const vInsights = document.getElementById('insights-view-container');
            const vAccounts = document.getElementById('accounts-view-container');
            const vHistory = document.getElementById('history-view-container');
            const vAdmin = document.getElementById('admin-view-container');

            if (vNeural) vNeural.style.display = 'none';
            if (vCockpit) vCockpit.style.display = 'none';
            if (vInsights) vInsights.style.display = 'none';
            if (vAccounts) vAccounts.style.display = 'none';
            if (vHistory) vHistory.style.display = 'none';
            if (vAdmin) vAdmin.style.display = 'none';

            if (asset === 'NEURAL') {
                if (vNeural) vNeural.style.display = 'block';
                const tabEl = document.getElementById('tab-neural');
                const sideEl = document.getElementById('side-nav-neural');
                if (tabEl) tabEl.classList.add('active-neural');
                if (sideEl) sideEl.classList.add('active');

                if (!window.neuralGlobeInitialized) {
                    setTimeout(() => { initBullionNeuralGlobe(); }, 30);
                } else if (window.resizeBullionNeuralGlobe) {
                    setTimeout(() => { window.resizeBullionNeuralGlobe(); }, 30);
                }
                if (window.lastDashboardData) {
                    renderNeuralCommandCenter(window.lastDashboardData, activeNeuralAsset);
                }
            } else if (asset === 'XAUUSD' || asset === 'BTCUSD') {
                if (vCockpit) vCockpit.style.display = 'block';
                const tabKey = asset === 'XAUUSD' ? 'gold' : 'btc';
                const tabEl = document.getElementById('tab-' + tabKey);
                const sideEl = document.getElementById('side-nav-' + tabKey);
                if (tabEl) tabEl.classList.add(asset === 'XAUUSD' ? 'active-gold' : 'active-btc');
                if (sideEl) sideEl.classList.add('active');
                setChartMode(asset);
            } else if (asset === 'INSIGHTS') {
                if (vInsights) vInsights.style.display = 'block';
                const tabEl = document.getElementById('tab-insights');
                const sideEl = document.getElementById('side-nav-insights');
                if (tabEl) tabEl.classList.add('active-insights');
                if (sideEl) sideEl.classList.add('active');
                if (typeof renderModelStatusPanel === 'function') renderModelStatusPanel('ALL');
                if (typeof renderInsightsModelsTable === 'function') renderInsightsModelsTable();
            } else if (asset === 'ACCOUNTS') {
                if (vAccounts) vAccounts.style.display = 'block';
                const tabEl = document.getElementById('tab-accounts');
                const sideEl = document.getElementById('side-nav-accounts');
                if (tabEl) tabEl.classList.add('active');
                if (sideEl) sideEl.classList.add('active');
                if (typeof renderAccountsView === 'function') renderAccountsView();
            } else if (asset === 'HISTORY') {
                if (vHistory) vHistory.style.display = 'block';
                const tabEl = document.getElementById('tab-history');
                const sideEl = document.getElementById('side-nav-history');
                if (tabEl) tabEl.classList.add('active');
                if (sideEl) sideEl.classList.add('active');
                if (typeof renderHistoryView === 'function') renderHistoryView();
            } else if (asset === 'ADMIN') {
                if (vAdmin) vAdmin.style.display = 'block';
                const tabEl = document.getElementById('tab-admin');
                const sideEl = document.getElementById('side-nav-admin');
                if (tabEl) tabEl.classList.add('active');
                if (sideEl) sideEl.classList.add('active');
                if (typeof renderAdminView === 'function') renderAdminView();
            }
        }

        function toggleSidebar() {
            sidebarCollapsed = !sidebarCollapsed;
            const sb = document.getElementById('mainSidebar');
            if (sb) {
                if (sidebarCollapsed) sb.classList.add('collapsed');
                else sb.classList.remove('collapsed');
            }
            if (window.resizeBullionNeuralGlobe) {
                setTimeout(window.resizeBullionNeuralGlobe, 300);
            }
        }

        // Auto-initialize on load
        window.addEventListener('DOMContentLoaded', () => {
            switchAsset('NEURAL');
            fetchLiveStatus();
            setInterval(fetchLiveStatus, 1000);
        });
    </script>
</body>
</html>
