# ==============================================================================
# CLAUDE / NVIDIA MULTI-AGENT XAUUSD AI TRADER - CONFIGURATION
# ==============================================================================

# AI Provider Selection: "anthropic", "nvidia", "groq", or "ollama"
AI_PROVIDER=anthropic

# 1. Anthropic Claude Settings (If using AI_PROVIDER=anthropic)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5

# 2. NVIDIA NIM Cloud Settings (If using AI_PROVIDER=nvidia - 100% FREE Tier)
# Get free key starting with 'nvapi-' from: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
# Recommended NVIDIA Models:
# - meta/llama-3.3-70b-instruct (Ultra Fast & Structured)
# - deepseek-ai/deepseek-r1 (Deep Mathematical Thinking)
# - qwen/qwen2.5-72b-instruct (Market Geometry)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# 3. Groq Cloud Settings (If using AI_PROVIDER=groq - 100% FREE Tier)
# Get free key from: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 4. MetaTrader 5 Connection Settings
# (Leave empty if MT5 is already running & logged in on your machine)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Symbol & Risk Management
TRADING_SYMBOL=XAUUSD
MAGIC_NUMBER=777888
MAX_RISK_PER_TRADE_PCT=1.0      # 1.0% risk per trade
MIN_RISK_REWARD_RATIO=1.5       # Minimum 1:1.5 RR ratio
MAX_DAILY_DRAWDOWN_PCT=100.0    # Set to 100.0 for unrestricted testing / 3.0 for strict prop firm rules
MAX_SPREAD_POINTS=35            # Max spread filter in points

MAX_OPEN_TRADES=2               # Max concurrent open positions
MAX_LOT_SIZE=0.10               # HARD CEILING: Never execute more than 0.10 lots
MIN_LOT_SIZE=0.01               # Minimum micro lot


# Strategy Timeframes
EXECUTION_TIMEFRAME=M15         # Primary decision timeframe: M15
CONTEXT_TIMEFRAME=H1            # Trend context timeframe: H1
MACRO_TIMEFRAME=H4              # Macro trend context: H4

# News Filter (ForexFactory & Investing.com)
ENABLE_NEWS_FILTER=true
NEWS_BLACKOUT_MINUTES=15
